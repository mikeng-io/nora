    "howHeading": "點樣記嘢",
    "howBody": "每條 message 都 ambient ingest（記低 + 餵 Honcho），但唔會應 — 除非有人 tag 佢。Tag 咗先入 agent loop：讀 context → 諗 → 答。",
    "techHeading": "技術架構",
    "techIntro": "Nora 唔係一個 prompt 加一個 model — 佢有五個 tier，儲緊五種唔同嘅 knowing。",
    "tier": {
      "memory": {
        "title": "Memory",
        "domain": "人",
        "description": "關於人嘅 soft memory。每條 message 都 ambient ingest 去 Honcho，Deriver 慢慢建立對每個人嘅 read；tag 嗰陣先讀返出嚟。"
      },
      "standing": {
        "title": "Standing",
        "domain": "佢嘅位置",
        "description": "佢喺每個 conversation 嘅 position。每個 turn 完咗，第二個 model 會 review 成個 exchange，重寫佢嘅 standing — lossy by design，上限 1200 字符。"
      },
      "notes": {
        "title": "Notes",
        "domain": "未解決嘅問題",
        "description": "未解決嘅問題，專登 track 住。每條 note 有 closing condition — 咩會 settle 佢。背景 curator 會 merge、retire、promote。"
      },
      "knowledge": {
        "title": "Knowledge",
        "domain": "世界",
        "description": "關於世界嘅 fact，擺喺一個 bitemporal knowledge graph。每個 fact 有 warrant（source / observation / stated / premises）加 fidelity（tentative / proven / deprecated）。"
      },
      "language": {
        "title": "Language",
        "domain": "字",
        "description": "房入面嘅字。Lexeme 有 gloss + counts，scored + decaying，stale 咗就唔再 render。仲有 exchange observation — 邊個同邊個講咗啲乜。"
      }
    },
    "afterHeading": "登入之後",
    "afterBody": "登入之後睇到佢嘅狀態、記憶、遊戲伺服器，同埋大家而家喺邊 — 淨係俾班到，第啲人睇唔到。",
    "cardEyebrow": "Nora · 入口",
    "cardHeading": "登入",
    "cardDek": "登入之後睇到佢嘅狀態、記憶、遊戲伺服器，同埋大家而家喺邊 — 淨係俾班到，第啲人睇唔到。",
    "cardCta": "用 Discord 登入",
    "diffHeading": "唔係另一個 workspace agent",
    "diffIntro": "Claude Tag 喺 Slack，Kiro Crew 喺你嘅 IDE，OpenClaw 喺你部機。Nora 喺你哋嘅 group chat — 一個冇人佔嘅地方。",
    "diff": {
      "1": {
        "badge": "vs Claude Tag",
        "title": "佢記得人，唔係 code",
        "description": "其他 agent 記得 codebase、repos、tickets。Nora 記得你哋 — 朋友、group 講過咩、邊個幾時結婚。Social memory 係一個冇人做過嘅 category。"
      },
      "2": {
        "badge": "vs Kiro Crew",
        "title": "Ambient 唔等於 proactive",
        "description": "其他 agent 嘅「ambient」係 LLM 自己判斷幾時出聲。Nora 嘅 ambient ingest 係零 LLM — 純記錄，冇推理。知識係 ambient，行動先係 reactive。"
      },
      "3": {
        "badge": "vs OpenClaw",
        "title": "沉默就係 feature",
        "description": "其他 agent 賣 proactive、賣 full access。Nora 相反 — silence beats wrong answer。最有用嘅 agent 係知道幾時唔好出聲嗰個。"
      }
    }
  },
