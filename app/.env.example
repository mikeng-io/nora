# Discord OAuth app credentials (design spec §4). Create an app at
# https://discord.com/developers/applications, add a redirect URI of
# <this app's origin>/api/auth/callback/discord, and copy its client id/secret
# here. Never commit the real values.
AUTH_DISCORD_ID=your-discord-client-id
AUTH_DISCORD_SECRET=your-discord-client-secret

# Auth.js session-signing secret. Generate with:
#   openssl rand -hex 32
# Never commit the real value.
AUTH_SECRET=your-auth-secret

# The public origin this app is served at once cloudflared bridges it
# (design spec §6) — nora.67.zone in production. Needed so Auth.js's OAuth
# callback URL matches what's registered with Discord.
AUTH_URL=https://nora.67.zone

# Path to the identity.toml Nora's own process also reads (design spec §4) —
# bind-mounted read-only into the container in production
# (docker-compose.yml's `app` service). Defaults to /app/identity.toml if unset.
# IDENTITY_TOML_PATH=/app/identity.toml

# Where the same-origin proxy routes (/api/status, /api/memory) reach Nora's
# aiohttp app. Defaults to http://nora:9100 (the docker-compose service name)
# if unset — only needed here for local dev against a different host.
# NORA_API_BASE=http://nora:9100

# DEV/DEMO ONLY (app/src/auth.ts) — never set this in a real deploy. Adds a
# "Continue as <fixture>" button to /login that logs in as a fixed Discord
# snowflake without real OAuth, so the (portal) auth gate can be exercised
# without a registered Discord app.
# AUTH_STUB=true
