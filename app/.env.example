# The portal's environment. In production these come from the host's
# environment through docker-compose.yml's `app` service; for local
# development copy this file to .env.local (gitignored) and use the
# "Local development" block at the bottom.

# Discord OAuth app. Create one at https://discord.com/developers/applications
# with the redirect URI <this app's origin>/api/auth/callback/discord.
# Never commit the real values.
AUTH_DISCORD_ID=your-discord-client-id
AUTH_DISCORD_SECRET=your-discord-client-secret

# Auth.js session-signing secret: openssl rand -hex 32. Never commit it.
AUTH_SECRET=your-auth-secret

# The public origin (nora.67.zone in production), so the OAuth callback URL
# matches what Discord has registered.
AUTH_URL=https://nora.67.zone

# identity.toml, the same file Nora reads, bind-mounted read-only. Defaults
# to /app/identity.toml.
# IDENTITY_TOML_PATH=/app/identity.toml

# Where the /api/v1 proxy reaches Nora's API. Defaults to http://nora:9100
# (the compose service). The browser never sees this address.
# NORA_API_BASE=http://nora:9100

# ---------------------------------------------------------------- Local
# development: the generated mock API and the dev-only sign-in picker.
# NORA_DEV_LOGIN works only under `next dev`; a production build ignores it.
#
# AUTH_SECRET=dev-only-secret-not-for-production-0123456789abcdef
# AUTH_DISCORD_ID=dev-placeholder
# AUTH_DISCORD_SECRET=dev-placeholder
# AUTH_URL=http://localhost:3400
# NORA_DEV_LOGIN=1
# IDENTITY_TOML_PATH=./dev/identity.dev.toml
# NORA_API_BASE=http://127.0.0.1:9199
# NEXT_PUBLIC_SW_DEV=1   # register the service worker under next dev too
