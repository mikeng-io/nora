{
  "name": "nora-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/vendor-maplibre.mjs",
    "dev": "next dev --port 3400",
    "dev:mock": "node dev/mock-nora.mjs",
    "dev:all": "node scripts/vendor-maplibre.mjs && node dev/run-dev.mjs",
    "prebuild": "node scripts/vendor-maplibre.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test",
    "documents:emit": "node --experimental-strip-types scripts/emit-document-schema.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-hk": "5.3.0",
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/query-async-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.11.2",
    "mermaid": "12.2.0",
    "next": "^16.3.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "server-only": "^0.0.1",
    "smol-toml": "^1.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ajv": "8.20.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "inline-style-parser": "0.2.9"
  }
}
