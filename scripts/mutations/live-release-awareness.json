    "old": "known = ({\"known\": list(lookup.known), \"known_source\": \"shipped_snapshot\"}",
    "new": "known = ({\"known\": [], \"known_source\": \"shipped_snapshot\"}",
    "target": "tests/integration/test_version_releases.py::test_an_unknown_release_is_distinct_from_a_failed_check"
  },
  {
