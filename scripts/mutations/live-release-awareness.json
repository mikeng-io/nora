    "new": "Check running and published versions when asked about upgrades or changes to yourself.",
    "target": "tests/unit/test_tool_catalogue.py::test_confusable_pairs_are_discriminated_in_the_catalogue_itself"
  },
  {
    "name": "an unknown public tag still offers the recorded alternatives",
