# OmniRoute API key for LLM calls (read by name via llm.api_key_env)
# Never commit the real value; never log it (R-16).
OMNIROUTE_API_KEY=your-key-here

# Required by Compose even when selecting a subset of services. Replace with
# the account provisioned in signal-cli; this placeholder is not a registration.
SIGNAL_ACCOUNT=replace-with-your-registered-account

# Required by Compose for the db service and Nora's DATABASE_URL. Generate a
# strong URL-safe password and keep the actual value outside version control.
POSTGRES_PASSWORD=replace-with-a-generated-password

# Shared bearer for the WhatsApp and Instagram transport bridges. WhatsApp's
# /health stays open; Instagram protects /health too. Each bridge refuses to
# start without it, so co-networked containers cannot read private events or
# send as the account. Compose interpolates the `${NORA_BRIDGE_TOKEN:?…}`
# requirement project-wide: even `docker compose ... db` fails without it.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
NORA_BRIDGE_TOKEN=replace-with-a-generated-token

# Canonical bearer name for the Python bridges (signal-bridge, discord-bridge).
# They fall back to NORA_BRIDGE_TOKEN above — same secret, one value; only the
# new name is set going forward so both spellings resolve.
NORA_BRIDGE_API_TOKEN=replace-with-a-generated-token

# HMAC key (64 hex chars) minting the opaque event_id aliases the bridges put
# on inbound envelopes. Rotate by bumping NORA_BRIDGE_CORRELATION_KEY_VERSION;
# old aliases still resolve to the original stream entry (no lost events).
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
NORA_BRIDGE_CORRELATION_KEY=replace-with-a-generated-64-hex-key
# NORA_BRIDGE_CORRELATION_KEY_VERSION=1

# Stream account legs — explicit opaque keys, NEVER derived from account ids
# or phone numbers. Each MUST equal the matching [platforms.<name>]
# account_key in config.toml or the app's reader names a different stream.
SIGNAL_BRIDGE_ACCOUNT_KEY=signal-acct-1
# DISCORD_BRIDGE_ACCOUNT_KEY=discord-acct-1
# WHATSAPP_BRIDGE_ACCOUNT_KEY=whatsapp-acct-1
# INSTAGRAM_BRIDGE_ACCOUNT_KEY=instagram-acct-1

# Passwords for the Redis the platform bridges hand inbound events to — one
# per ACL role (docker-compose.yml's redis entrypoint writes users.acl on
# tmpfs; `user default` is OFF, so nothing authenticates unrestricted):
#   nq-producer — every bridge's enqueue/dedupe (their NORA_REDIS_URL)
#   nq-consumer — the app's claim/ack/inspect reader (nora's NORA_REDIS_URL)
#   nq-inspector — read-only ops/telemetry access for `redis-cli` sessions
# All three are required by Compose interpolation. Keep them URL-safe and
# distinct: a leaked bridge password must not carry consumer rights.
# Generate each with: python -c "import secrets;print(secrets.token_urlsafe(32))"
NORA_REDIS_PRODUCER_PASSWORD=replace-with-a-generated-password
NORA_REDIS_CONSUMER_PASSWORD=replace-with-a-generated-password
NORA_REDIS_INSPECTOR_PASSWORD=replace-with-a-generated-password

# Compose supplies DATABASE_URL using POSTGRES_PASSWORD and the db service DNS.
# Compose publishes the bundled PostgreSQL on 127.0.0.1:5435. For a process run
# directly on the host, set DATABASE_URL with the same POSTGRES_PASSWORD:
# DATABASE_URL=postgresql+asyncpg://nora:<POSTGRES_PASSWORD>@127.0.0.1:5435/nora

# Portal values are required by Compose interpolation even when selecting a
# subset of services. Provision your own Discord OAuth app and public origin.
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
AUTH_SECRET=replace-with-a-generated-secret
AUTH_URL=https://<portal-host>

# AES-256 key for media encryption at rest (read by name via media.encryption_key_env),
# base64 of 32 random bytes. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Unset (or media.enabled=false) means media custody is OFF — attachments are
# recorded with a placeholder and no handle. Never commit the real value.
# MEDIA_ENCRYPTION_KEY=your-base64-32-byte-key

# Google Maps Platform key for the `route` tool (read by name via route.api_key_env),
# only used when route.enabled = true. Restrict the key at Google to Routes +
# Places + Geocoding, and set a billing budget alert. Never commit the real value.
# GOOGLE_MAPS_API_KEY=your-key-here

# Giphy API key for described reaction GIF lookup. Unset means the GIF tools
# stay unavailable. Never commit a real key.
# GIPHY_API_KEY=your-key-here

# Web search + page extraction keys for `web_search`/`web_fetch`, read by name
# via [search.tavily].api_key_env / [search.exa].api_key_env. Only the key for
# the backend named by [search].provider is ever read (DEC-157) — export the
# other or not, it changes nothing. Unset means both tools answer `unavailable`
# (R-5), never a silent empty. Never commit a real key.
# TAVILY_API_KEY=your-key-here
# EXA_API_KEY=your-key-here

# Steam Web API key for the online_now tool's Steam half ([online].api_key_env,
# design/online-status/). Read-only presence reads — who is online, who is
# playing what. Unset means the `online`/`playing` arms answer `unavailable`
# (R-5), never a confident "everyone is offline". Never commit a real key.
# STEAM_WEB_API_KEY=your-key-here

# xAI refresh token for the image-generation lane (DEC-137). NOT a secret you
# type: run `nora xai-login` from the repo root — device flow against
# auth.x.ai, the account owner approves in a browser, and the CLI appends this line
# itself. Access tokens never live here; they refresh automatically into
# ./state/xai-oauth.json. Without this + [image_gen].enabled=true the
# generate_image tool answers unavailable.
# XAI_OAUTH_REFRESH_TOKEN=

# OpenAI Codex (ChatGPT subscription) image lane, `[image_gen] provider =
# "openai_codex"` (DEC-304). Run `nora openai-codex-login` from the repo root:
# a device login for NORA's own ChatGPT account, and the CLI writes this line.
# It is a BOOTSTRAP: the first refresh spends it and the rotated token lives
# in ./state/openai-codex-oauth.json. Never paste a token from ~/.codex.
# OPENAI_CODEX_REFRESH_TOKEN=

# Kimi Code API key for the DIRECT media-describer lane ([media.describe.*]
# provider="kimi", 2026-08-30): `api.kimi.com/coding/v1`. Required for VIDEO
# because OmniRoute drops `video_url` content blocks. Omit it and a kimi
# provider answers unavailable (never a silent omniroute fallback).
# KIMI_CODE_API_KEY=

# OpenCode Go API key for the DIRECT describer lane ([media.describe.*]
# provider="opencode-go", DEC-197): `opencode.ai/zen/go/v1`, MiMo v2.6 Flash
# for video with sound and for audio. Omit it and those modalities answer
# unavailable (never a silent omniroute fallback).
# OPENCODE_GO_API_KEY=

# OTLP auth headers for the tracing exporter (read by name via obs.tracing.headers_env),
# only consulted when obs.tracing.exporter = "otlp_http". Same shape OTel's own
# OTEL_EXPORTER_OTLP_HEADERS uses: comma-separated key=value pairs, URL-encoded.
# Langfuse wants a Basic auth header built from its public/secret key pair.
# Unset (or the config's headers_env left "") means no auth header is sent.
# Also read by evals.langfuse.headers_env (evals/sink.py's LangfuseEvalSink) — the
# SAME credential, decoded the same way, reused rather than duplicated (Phase 7 / DEC-6).
# LANGFUSE_OTLP_HEADERS=Authorization=Basic%20<base64(public_key:secret_key)>

# Bearer token for the `pulse` MCP server (read by name via
# tools.mcp.pulse.token_env), only used when tools.mcp.pulse.enabled = true.
# Unset means the `pulse` mount is silently skipped and its tools are absent
# (never a crash, never a leak — spec: docs/superpowers/specs/2026-08-08-mcp-tool-provider-design.md).
# Never commit the real value.
# PULSE_MCP_TOKEN=your-token-here

# Root credentials for the `rustfs` service's S3 API (docker-compose.yml),
# Nora's blob store ([media.rustfs]): every attachment, generated image and
# computer export lives there. Required (compose uses `:?`, not `:-`); the
# container refuses to start without both set. Never commit real values.
RUSTFS_ROOT_USER=your-rustfs-root-user
RUSTFS_ROOT_PASSWORD=your-rustfs-root-password

# One-time codes ([otp], `nora.app.otp`), read only when `[otp] enabled = true`.
# NORA_OTP_SECRET is the HMAC key codes are hashed under before they are stored
# (generate with `openssl rand -hex 32`); NORA_OTP_API_TOKEN is the bearer the
# portal sends to /app/v1/otp/*. Never commit real values.
# NORA_OTP_SECRET=your-otp-hmac-key
# NORA_OTP_API_TOKEN=your-otp-api-token

# Nora's ONE Google identity ([google], design/external-files §4): one
# Desktop-app OAuth client and one refresh token for her own account, shared by
# every Google service she uses (shared files today). The consent screen must be
# In production (in Testing the refresh token dies after 7 days). The refresh
# token comes from `uv run python scripts/google_auth.py`, run on a machine with
# a browser; re-run it with the same client when a Google service is added.
# Read only by a Google service that is switched on. Never commit real values.
# GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token

# Discord bot token, from the Discord Developer Portal application (bot user,
# MESSAGE_CONTENT privileged intent enabled). Read by DiscordAdapter — see
# design/discord-integration/. Never commit the real value.
# DISCORD_BOT_TOKEN=your-bot-token-here

# Discord OAuth2 app credentials (same application, OAuth2 tab), used by the
# portal auth service for Discord SSO login -- see
# design/discord-integration/03-identity-and-portal-auth.md. CLIENT_ID is
# public; CLIENT_SECRET must stay server-side only. Never commit real values.
# DISCORD_CLIENT_ID=your-client-id-here
# DISCORD_CLIENT_SECRET=your-client-secret-here

# Sentry DSN, read by NAME via obs.errors.dsn_env (DEC-8: never inlined in
# config.toml). Only consulted when obs.errors.enabled = true; unset or empty
# means error reporting is off, which is the shipped default.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Which Discord channel receives an alert. Read by docker-compose into the
# alert-bridge container (deploy/alert-bridge/), which turns an Alertmanager
# webhook into a message in that channel using DISCORD_BOT_TOKEN above. Empty
# means alerts are rendered and LOGGED but not delivered — the bridge reports
# that at ERROR rather than pretending to have sent.
# ALERT_DISCORD_CHANNEL=100000000000000207

# Voice (design/voice-channel/). NOTHING GUILD-SPECIFIC LIVES HERE any more
# (multi-guild, 2026-09-17). A guild id is not a secret — it is in every
# Discord URL — and .env is for secrets. Which servers Nora holds voice on is
# config.toml's `[speech.tts] sidecars`; where each server's speech is
# RECORDED is policy.toml's `voice = true`. One place each, no third copy.
#
# The sidecar creates a connection per server on demand and restores them from
# its own state volume on restart; the wake gate learns the server from the
# audio connection itself. Both are identical on every deployment.
#
# The wake gate's MODEL knobs (threshold, STT engine, silence tail...) are in
# config.toml [speech.wake] / [speech.stt] (2026-09-17), which compose mounts
# into the voice-wake and stt containers — `nora config set
# speech.wake.threshold 0.45` then `docker compose restart voice-wake`. A
# VOICE_WAKE_THRESHOLD line here is ignored.

# The deployment's own Signal number, the account signal-cli runs as
# (docker-compose.yml). Required: unset, every `docker compose` command in this
# project refuses to run, which is the point (a placeholder would run signal-cli
# as an unregistered account). Never commit the real value.
# SIGNAL_ACCOUNT=+852XXXXXXXX

# The game-server dashboard's API base (`nora/web/games.py`), a private tailnet
# host; used only when PULSE_API_TOKEN is set.
# PULSE_API_BASE=https://your-host.your-tailnet.ts.net/pulse/api/v1

# Where the host keeps the `embedder` service's model files, the Qwen3-VL-
# Embedding-2B Q4_K_M GGUF and its f16 projector (docker-compose.yml,
# design/unified-memory/65-build-step-3-vectors.md). Mounted read-only.
# EMBEDDER_MODELS_DIR=./models/embedder
