# OmniRoute API key for LLM calls (read by name via llm.api_key_env)
# Never commit the real value; never log it (R-16).
OMNIROUTE_API_KEY=your-key-here

# OTLP auth headers for the tracing exporter (read by name via obs.tracing.headers_env),
# only consulted when obs.tracing.exporter = "otlp_http". Same shape OTel's own
# OTEL_EXPORTER_OTLP_HEADERS uses: comma-separated key=value pairs, URL-encoded.
# Langfuse wants a Basic auth header built from its public/secret key pair.
# Unset (or the config's headers_env left "") means no auth header is sent.
# Also read by evals.langfuse.headers_env (evals/sink.py's LangfuseEvalSink) — the
# SAME credential, decoded the same way, reused rather than duplicated (Phase 7 / DEC-6).
# LANGFUSE_OTLP_HEADERS=Authorization=Basic%20<base64(public_key:secret_key)>