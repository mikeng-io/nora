# OmniRoute API key for LLM calls (read by name via llm.api_key_env)
# Never commit the real value; never log it (R-16).
OMNIROUTE_API_KEY=your-key-here

# PostgreSQL URL of the record store (read by name via store.database_url_env,
# default DATABASE_URL). asyncpg-shaped — the sync/Alembic driver is derived from
# it. docker compose reaches nora-db by name on the private `nora` network; the
# database publishes no host port (design/20 §3). Never commit real credentials.
DATABASE_URL=postgresql+asyncpg://nora:nora@nora-db/nora

# AES-256 key for media encryption at rest (read by name via media.encryption_key_env),
# base64 of 32 random bytes. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Unset (or media.enabled=false) means media custody is OFF — attachments are
# recorded with a placeholder and no handle. Never commit the real value.
# NORA_MEDIA_KEY=your-base64-32-byte-key

# Google Maps Platform key for the `route` tool (read by name via route.api_key_env),
# only used when route.enabled = true. Restrict the key at Google to Routes +
# Places + Geocoding, and set a billing budget alert. Never commit the real value.
# GOOGLE_MAPS_API_KEY=your-key-here

# Giphy API key for described reaction GIF lookup. Unset means the GIF tools
# stay unavailable. Never commit a real key.
# GIPHY_API_KEY=your-key-here

# xAI refresh token for the image-generation lane (DEC-137). NOT a secret you
# type: run `nora xai-login` from the repo root — device flow against
# auth.x.ai, Miles approves in browser once, and the CLI appends this line
# itself. Access tokens never live here; they refresh automatically into
# ./state/xai-oauth.json. Without this + [image_gen].enabled=true the
# generate_image tool answers unavailable.
# XAI_OAUTH_REFRESH_TOKEN=

# OTLP auth headers for the tracing exporter (read by name via obs.tracing.headers_env),
# only consulted when obs.tracing.exporter = "otlp_http". Same shape OTel's own
# OTEL_EXPORTER_OTLP_HEADERS uses: comma-separated key=value pairs, URL-encoded.
# Langfuse wants a Basic auth header built from its public/secret key pair.
# Unset (or the config's headers_env left "") means no auth header is sent.
# Also read by evals.langfuse.headers_env (evals/sink.py's LangfuseEvalSink) — the
# SAME credential, decoded the same way, reused rather than duplicated (Phase 7 / DEC-6).
# LANGFUSE_OTLP_HEADERS=Authorization=Basic%20<base64(public_key:secret_key)>

# Bearer token for the `pulse` MCP server (read by name via
# tools.mcp.pulse.token_env), only used when tools.mcp.pulse.enabled = true.
# Unset means the `pulse` mount is silently skipped and its tools are absent
# (never a crash, never a leak — spec: docs/superpowers/specs/2026-08-08-mcp-tool-provider-design.md).
# Never commit the real value.
# PULSE_MCP_TOKEN=your-token-here

# Root credentials for the `rustfs` service's S3 API (docker-compose.yml),
# artifact-byte storage for the `drop` service (spec:
# docs/superpowers/specs/2026-08-12-nora-drop-design.md). Required (compose
# uses `:?`, not `:-`) — `deploy/drop/artifacts.py`'s `PgRustfsArtifactStore`
# calls this to write/read artifact bytes; the container refuses to start
# without both set. Never commit real values.
RUSTFS_ROOT_USER=your-rustfs-root-user
RUSTFS_ROOT_PASSWORD=your-rustfs-root-password

# Bearer token for `drop`'s INTERNAL listener (docker-compose.yml's
# `drop` service, port 8081) — guards `POST /api/links` and
# `POST /api/artifacts` (deploy/drop/auth.py). Same shape as
# NORA_SHORTENER_TOKEN, a new/separate value: `drop` is a different service,
# not a reuse of `n.example.net`'s Worker secret. Defence in depth only — the
# primary control is that this listener has no `ports:` entry and no Tunnel
# ingress rule at all (spec §5a); a compromise of the token alone, without
# network access to the `nora` Docker network, reaches nothing. This is also
# the token `nora.infra.drop.DropArtifactIngest` (a future Compute tool's
# HTTP client) would be constructed with, once something in this repo calls
# it. Never commit the real value.
NORA_DROP_TOKEN=your-drop-internal-token

# Signs/verifies `drop`'s per-job scoped tokens (docker-compose.yml's `drop`
# service; deploy/drop/auth.py's `mint_job_token`/`verify_job_token`) --
# minted by `POST /api/tokens` (master-token-only) and handed to a Compute
# job's container so it can write only its own artifact, for a short TTL
# rather than an active revoke call. Separate secret from NORA_DROP_TOKEN --
# a job token is never compared to the master token directly. Never commit
# the real value.
DROP_JOB_TOKEN_SECRET=your-drop-job-token-secret

# The HOST-side path of whatever docker-compose.yml mounts at /app/data
# (read by name via compute.data_host_root_env). Only needed when
# `[compute] enabled = true` — Nora REFUSES TO START without it then, and
# ignores it entirely otherwise (the mount falls back to `./data`, unchanged).
#
# It exists because a compute job's workspace is bind-mounted into Smith's
# sandbox container by the HOST Docker daemon, which resolves a bind SOURCE on
# the host filesystem. `/app/data/...` — what that directory is called inside
# Nora's own container — does not exist there, and the daemon does not complain:
# it creates an empty directory, the sandbox finds no brief, Nora finds no
# result, and every job fails with nothing to read.
#
# MUST BE ABSOLUTE, and must be the same directory as the mount: compose uses
# this same variable for the mount source, so setting it moves both together.
# For a checkout at ~/workspace/nora that is:
# NORA_DATA_HOST_ROOT=/home/youruser/workspace/nora/data

# GID of the HOST's `docker` group (must match `getent group docker`
# on this host, not portable across hosts/distros) -- lets Nora's own
# container process reach the mounted /var/run/docker.sock, for
# LocalDockerBackend's docker.from_env() (only load-bearing when
# [compute] enabled = true). Unset falls back to this host's own value (973).
# DOCKER_GID=973

# Discord bot token, from the Discord Developer Portal application (bot user,
# MESSAGE_CONTENT privileged intent enabled). Read by DiscordAdapter — see
# design/discord-integration/. Never commit the real value.
# DISCORD_BOT_TOKEN=your-bot-token-here

# Discord OAuth2 app credentials (same application, OAuth2 tab), used by the
# portal auth service for Discord SSO login -- see
# design/discord-integration/03-identity-and-portal-auth.md. CLIENT_ID is
# public; CLIENT_SECRET must stay server-side only. Never commit real values.
# DISCORD_CLIENT_ID=your-client-id-here
# DISCORD_CLIENT_SECRET=your-client-secret-here
