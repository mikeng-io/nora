{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bootstrap-sha": "95a911342b7f8f44693e5b2e584a74d32236dc45",
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "changelog-sections": [
    {"type": "feat", "section": "Features"},
    {"type": "fix", "section": "Bug Fixes"},
    {"type": "security", "section": "Security"},
    {"type": "perf", "section": "Performance"},
    {"type": "change", "section": "Changes"},
    {"type": "doctrine", "section": "Doctrine"},
    {"type": "revert", "section": "Reverts"},
    {"type": "config", "section": "Configuration", "hidden": true},
    {"type": "refactor", "section": "Refactoring", "hidden": true},
    {"type": "docs", "section": "Documentation", "hidden": true},
    {"type": "design", "section": "Design", "hidden": true},
    {"type": "test", "section": "Tests", "hidden": true},
    {"type": "build", "section": "Build", "hidden": true},
    {"type": "ci", "section": "CI", "hidden": true},
    {"type": "ops", "section": "Operations", "hidden": true},
    {"type": "style", "section": "Style", "hidden": true},
    {"type": "chore", "section": "Chores", "hidden": true},
    {"type": "merge", "section": "Merges", "hidden": true}
  ],
  "always-update": true,
  "exclude-paths": ["docs", "design", "assets", ".agents", ".claude", ".github"],
  "packages": {
    ".": {
      "package-name": "nora",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {"type": "toml", "path": "uv.lock", "jsonpath": "$.package[?(@.name.value=='nora')].version"}
      ]
    }
  }
}
