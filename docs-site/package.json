{
  "name": "nora-wiki",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm test && astro build && npm run graph && node scripts/check-links.mjs",
    "preview": "astro preview",
    "graph": "cd .. && openwiki visualize openwiki --export docs-site/dist/graph && node docs-site/scripts/graph-directories.mjs",
    "wiki:update": "cd .. && openwiki code --update --print",
    "test": "node --test plugins/*.test.mjs scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "openwiki": "0.7.2"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
