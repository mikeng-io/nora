#!/usr/bin/env bash
# pre-commit hook: refuses a commit whose STAGED blobs add a real identifier
# (#283). Scans what the commit adds relative to HEAD (and MERGE_HEAD), never
# the working tree: residue already in the tree does not block an unrelated
# commit, and an unstaged edit is not what gets committed.
#
# Exit 0 PASS, 1 FAIL, 2 ERROR (could not look) - both non-zero block the
# commit. See scripts/pii_scan.py and .githooks/README.md.
#
# Path resolution and `python3` (not `uv run`) match .githooks/commit-msg -
# see that file for why (linked-worktree + stdlib-only).
set -euo pipefail

SCANNER="$(git rev-parse --show-toplevel)/scripts/pii_scan.py"
if [ ! -f "$SCANNER" ]; then
  echo "pre-commit: identifier scanner not found at $SCANNER - refusing to pass unverified" >&2
  echo "  are you on a branch without it? (see .githooks/README.md)" >&2
  exit 1
fi
exec python3 "$SCANNER" staged
