#!/usr/bin/env bash
# commit-msg hook: enforces CONTRIBUTING.md §Commit messages, and refuses a
# message or author identity that carries a real identifier (#283).
# Installed by `make hooks` (sets core.hooksPath=.githooks). Opt-in per clone,
# but the rule it enforces is not optional — this is the typing aid, not the law.
# Bypass for a genuinely exceptional subject: git commit --no-verify, and name
# the reason in the commit body.
#
# Four things this file must get right, all learned by breaking them:
#
# 1. RESOLVE AGAINST --show-toplevel, NEVER --git-common-dir. In a linked
#    worktree (git worktree add) the common dir is the MAIN checkout, so a
#    common-dir path points at main's tree — where the checker does not exist
#    until this branch merges. Every commit then fails, including valid ones,
#    and the hook reads as "the convention is broken" rather than "the hook is
#    broken". Measured 2026-09-14: `git commit -m 'chore: x'` in a linked
#    worktree exited 1 with "can't open file '.git/../scripts/...'".
# 2. USE `python3`, NOT `uv run`. The checkers are stdlib-only for exactly
#    this reason: the hook must not depend on a toolchain the contributor may
#    not have installed, and it must not care which venv is active.
# 3. RUN THE REPO'S SCANNER AND NOTHING ELSE (#283 round 3, finding e). A
#    symlink at scripts/, at the scanner or at its one import would run some
#    other file under this name, so any of them is refused; `-I -S` keeps
#    PYTHONPATH, PYTHONSTARTUP, user site and .pth files from substituting a
#    module of their own.
# 4. SCAN FOR IDENTIFIERS BEFORE ANYTHING PRINTS THE MESSAGE. The subject
#    checker echoes a bad subject as written; run first, it printed a
#    denylisted name the scanner would have masked (round 3, finding e). It
#    runs only once the scan has passed.
set -euo pipefail

TOPLEVEL="$(git rev-parse --show-toplevel)"
SCANNER="$TOPLEVEL/scripts/pii_scan.py"
CHECKER="$TOPLEVEL/scripts/check_commit_subject.py"
for p in "$TOPLEVEL/scripts" "$SCANNER" "$TOPLEVEL/scripts/pii_cjk_fold.py" "$CHECKER"; do
  if [ -L "$p" ]; then
    echo "commit-msg: $p is a symlink - refusing to run a checker that may not be this repo's" >&2
    exit 1
  fi
done
if [ ! -f "$SCANNER" ]; then
  echo "commit-msg: identifier scanner not found at $SCANNER - refusing to pass unverified" >&2
  exit 1
fi
if [ ! -f "$CHECKER" ]; then
  echo "commit-msg: checker not found at $CHECKER" >&2
  echo "  are you on a branch without the conventions commit? (see .githooks/README.md)" >&2
  exit 1
fi

# The message and the author/committer identity: values reach commit
# messages as easily as files, and a message is published with the history.
# On PASS this also records every acknowledgement the commit used
# (NORA_PII_ACK) as a `PII-Ack: <id> (human)` trailer.
python3 -I -S "$SCANNER" message "$1"
exec python3 -I -S "$CHECKER" "$1"
