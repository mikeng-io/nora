#!/usr/bin/env bash
# pre-push hook: refuses a push carrying commits whose subjects violate
# CONTRIBUTING.md §Commit messages — the last local chance before the branch is
# visible to others. Same checker, same rules, one source of truth.
#
# Checks EVERY commit in the pushed range, not just the tip: the batches that
# need this hook most are the ones committed BEFORE `make hooks` was installed,
# which means the defects are in the middle of the range, not on top of it.
# The range is capped at 200 commits per ref; past the cap it says so out loud,
# because silence there would read as "everything checked out".
#
# Path resolution and `python3` (not `uv run`) match .githooks/commit-msg —
# see that file for why (linked-worktree + stdlib-only).
set -euo pipefail

TOPLEVEL="$(git rev-parse --show-toplevel)"
CHECKER="$TOPLEVEL/scripts/check_commit_subject.py"
if [ ! -f "$CHECKER" ]; then
  echo "pre-push: checker not found at $CHECKER - refusing to pass unverified" >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
checked=0
failed=0

check_one() {  # $1 = sha
  local sha="$1" subject msgfile
  subject="$(git log -1 --format=%s "$sha")"
  msgfile="$(mktemp)"
  printf '%s\n' "$subject" > "$msgfile"
  if ! python3 "$CHECKER" "$msgfile"; then
    echo "  offending commit: $sha" >&2
    failed=1
  fi
  rm -f "$msgfile"
  checked=$((checked + 1))
}

# Git's pre-push protocol feeds FOUR fields per ref on stdin, so all four are
# read even though only `local_sha` is used now: dropping a name would shift
# the parse and put a sha in the wrong variable. `remote_ref` was already
# unused; `remote_sha` became unused when the range stopped being derived from
# it (#315), and it is kept named because the line documents the protocol.
# stdin is read once and kept: the identifier scan below needs the same lines.
push_lines="$(cat)"
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  [ "$local_sha" = "$zero" ] && continue   # branch deletion
  # Everything reachable from the tip that NO REMOTE ALREADY HAS - which is
  # exactly the set this push introduces, and is the right range whether the
  # ref is new or not. Passed as SEPARATE arguments (never one unquoted
  # string) - a single "$sha --not --remotes" word is not a revision, and
  # rev-list refuses it.
  #
  # **`$remote_sha..$local_sha` was wrong for an existing ref, and a rebase is
  # what exposed it** (#315). `remote_sha` is the BRANCH's previous remote tip,
  # so after `git rebase origin/master` that range contains every commit the
  # branch was rebased ONTO - all of master's recent history, including its
  # merge commits. Measured 2026-09-17 on `mikeng-io/fix-note-index-xml`: an
  # 8-commit branch was checked as 33, and the push was refused for a
  # GitHub-default merge subject on a commit that was already on `origin/master`
  # and had been accepted there.
  #
  # The two ways past that are both worse than the bug: `--no-verify` turns the
  # gate off for the whole push at exactly the moment a rebase has rewritten
  # history, or somebody amends a merge commit that is already on master to
  # satisfy a hook. A gate that can only be satisfied by rewriting shared
  # history teaches people to bypass it.
  #
  # It also interacted with the 200-commit cap below: on a long-lived branch
  # rebased onto a busy master, the commits actually being pushed could fall
  # outside the window and go unchecked while the hook reported it was working.
  #
  # `--remotes` means ANY remote. This repo has one; if that ever changes and a
  # fork's branches should not count as "already reviewed", the narrower form
  # is `--not --remotes=origin`.
  mapfile -t shas < <(git rev-list --max-count=201 "$local_sha" --not --remotes)
  if [ "${#shas[@]}" -gt 200 ]; then
    echo "pre-push: $local_ref has more than 200 commits; checking the newest 200 only" >&2
    shas=("${shas[@]:0:200}")
  fi
  for sha in "${shas[@]}"; do
    [ -z "$sha" ] && continue
    check_one "$sha"
  done
done <<< "$push_lines"

echo "pre-push: checked $checked commit subject(s)"

# Identifier backstop (#283): every blob, message and author identity the push
# introduces, with the same `--not --remotes` range. This is what catches a
# commit made with --no-verify, before the hooks were installed, or one whose
# payload a LATER commit `git rm`-ed: the object is still in the push.
SCANNER="$TOPLEVEL/scripts/pii_scan.py"
if [ ! -f "$SCANNER" ]; then
  echo "pre-push: identifier scanner not found at $SCANNER - refusing to pass unverified" >&2
  exit 1
fi
pii_rc=0
printf '%s\n' "$push_lines" | python3 "$SCANNER" push || pii_rc=$?
if [ "$pii_rc" -ne 0 ]; then
  failed=1
fi
exit "$failed"
