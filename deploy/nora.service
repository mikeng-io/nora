[Unit]
Description=Nora — ambient Signal group agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nora
Group=nora
WorkingDirectory=/home/nora/workspace/nora
EnvironmentFile=/etc/nora/nora.env
ExecStart=/home/nora/workspace/nora/.venv/bin/python -m nora --config /etc/nora/config.toml
Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nora/workspace/nora/data
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
