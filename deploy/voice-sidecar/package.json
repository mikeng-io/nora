{
  "name": "nora-voice-sidecar",
  "version": "0.2.0",
  "private": true,
  "description": "Audio-controller for Nora's Discord voice channel: sole owner of the voice connection \u2014 per-user PCM to the wake seam, TTS playback, music via ffmpeg \u2014 driven by nora over an HTTP control plane.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/service.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "smoke": "node smoke_test.mjs",
    "spike:mock": "node spike.mjs --mock",
    "spike:live": "node spike.mjs --live",
    "consume": "node consume.mjs"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "0.19.2",
    "@snazzah/davey": "0.1.12",
    "discord.js": "^14.23.2",
    "prism-media": "^1.3.5"
  },
  "overrides": {
    "@discordjs/node-pre-gyp": {
      "tar": "^7.5.22"
    },
    "undici": "8.10.2"
  }
}
