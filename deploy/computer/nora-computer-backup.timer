# Nightly, off-peak for Hong Kong (the host's clock). Persistent: a night the host
# was off is made up at the next start instead of skipped. Install:
# deploy/computer/README.md "Backup and restore".
[Unit]
Description=Nightly backup of Nora's computer's /workspace

[Timer]
OnCalendar=*-*-* 03:20:00
Persistent=true
RandomizedDelaySec=300
Unit=nora-computer-backup.service

[Install]
WantedBy=timers.target
