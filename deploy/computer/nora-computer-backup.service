# A nightly backup of Nora's computer's /workspace (design/sandbox-runtime sec 7,
# deploy/computer/README.md "Backup and restore"). A USER unit for the account that
# ran `sbx login`, fired by nora-computer-backup.timer. A recreate or a destroy
# deletes /workspace and the audit saw three recreates in one day, so this is the
# only copy that survives one. A failed run leaves the unit `failed`
# (`systemctl --user --failed`), and an old archive is never removed by a failure.
[Unit]
Description=Nora's computer: back up the VM's /workspace to ~/nora-backups

[Service]
Type=oneshot
ExecStart=%h/workspace/nora/deploy/computer/nora-computer backup
# A backup of a busy disk can take a while; never an hour.
TimeoutStartSec=1800
