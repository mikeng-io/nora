#!/usr/bin/env bash
# nora-computer: the lifecycle unit of Nora's computer (design/sandbox-runtime §2).
# The ONLY thing that runs `sbx`; Nora never holds the sbx or Docker socket.
# Runs on the deploy host as the user that ran `sbx login`.
#
#   nora-computer build    build the image and load it into sbx as a template
#   nora-computer serve    VM exists and publishes its port; computerd runs in the
#                          foreground (systemd supervises it)
#   nora-computer status   one line: sandbox state, computerd health, egress policy
#   nora-computer egress apply|check
#                          the VM's network allowlist (below): add it, or read it back
#   nora-computer policy-log [args]
#                          sbx policy log for the VM, as an audited read
#   nora-computer sync-events
#                          replay the lifecycle audit spool into computer_events
#   nora-computer stop     stop the VM (files persist)
#   nora-computer destroy  remove the VM and its disk
#
# `serve` is what nora-computer.service runs, with Restart=always. Health is an
# HTTP BODY from computerd: under sbx a TCP connect succeeds to any address,
# so a connect check proves nothing (spike round 2).
set -uo pipefail   # no -e: every step checks its own result and exits with a named code

NAME=${NORA_COMPUTER_NAME:-nora-computer}
IMAGE=${NORA_COMPUTER_IMAGE:-nora-computer:latest}
HOST_IP=${NORA_COMPUTER_HOST_IP:-172.17.0.1}   # docker0: the nora container reaches it, the LAN does not
HOST_PORT=${NORA_COMPUTER_PORT:-18765}
MEMORY=${NORA_COMPUTER_MEMORY:-3g}
CPUS=${NORA_COMPUTER_CPUS:-2}
ENV_FILE=${NORA_ENV_FILE:-$HOME/workspace/nora/.env}
HERE=$(cd "$(dirname "$0")" && pwd)
LOCK=${XDG_RUNTIME_DIR:-/tmp}/nora-computer.lock
STATE_DIR=${NORA_COMPUTER_STATE_DIR:-$HOME/.local/state/nora-computer}
UNUSED_WORKSPACE=${NORA_COMPUTER_UNUSED_WORKSPACE:-$STATE_DIR/unused-workspace-$NAME}
# The lifecycle audit (design/sandbox-runtime sec 12). A host-side spool is the
# first record of every operator-side event, and Postgres' computer_events is the
# record of truth it is replayed into; COMPOSE_DIR is where `docker compose exec
# db` finds the stack. See lifecycle_event.py.
SPOOL=$STATE_DIR/lifecycle-events.jsonl
COMPOSE_DIR=${NORA_COMPOSE_DIR:-$(dirname "$ENV_FILE")}

# The VM's egress, and the ONLY egress it has. sbx's policy is deny-all
# (`default-deny-all`, network `**`); these are the allow rules on top of it,
# scoped to this sandbox so no other sandbox on the host inherits them. The
# operator's ruling (2026-10-01): the VM may fetch packages from PyPI and the
# Ubuntu archive and nothing else, and nothing of Nora's own services: not
# computerd's own published port, not Honcho, OmniRoute or the LAN (design
# sandbox-runtime sec 1 and 8). Ports are part of each rule: pip is HTTPS only;
# apt's default sources are plain HTTP on :80 (the policy log counted 424 refused
# fetches of archive.ubuntu.com:80 and security.ubuntu.com:80 on 2026-10-01) and
# fall back to :443. A constant, not an environment variable: the allowlist is
# reproducible setup, and a host that edits it by environment is a host whose
# policy nobody can read off this file.
EGRESS_ALLOW=(
    pypi.org:443
    files.pythonhosted.org:443
    archive.ubuntu.com:80
    archive.ubuntu.com:443
    security.ubuntu.com:80
    security.ubuntu.com:443
)

# The desktop keyring is locked on a headless host; point sbx at nothing and
# it falls back to its file store (spike round 1).
export DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent

log() { echo "$(date -Is) nora-computer: $*"; }

# Replay the whole spool into computer_events. Idempotent (ON CONFLICT DO
# NOTHING, so a row already there is skipped and nothing is ever updated), so it
# is safe to run after every event and by hand. A db that is not up yet is the
# ordinary reason it fails at boot; the spool keeps the event until it is.
sync_events() {
    local sql
    [ -s "$SPOOL" ] || return 0
    sql=$(python3 "$HERE/lifecycle_event.py" sql --spool "$SPOOL") || return 1
    printf '%s\n' "$sql" | (cd "$COMPOSE_DIR" && timeout 30 docker compose exec -T db \
        psql -U nora -d nora -v ON_ERROR_STOP=1 -q) >/dev/null 2>&1
}

# record_event EVENT STATUS [key=value ...]: one audit event, spool first. The
# spool write failing is the only failure that is returned: the event is lost,
# and the caller of a destructive step says so loudly. Postgres lagging is
# logged and recoverable (`nora-computer sync-events`). Never prints a token.
record_event() {
    local event=$1 status=$2 args=() kv
    shift 2
    for kv in "$@"; do args+=(--detail "$kv"); done
    mkdir -p "$STATE_DIR" || return 1
    python3 "$HERE/lifecycle_event.py" record --spool "$SPOOL" --event "$event" \
        --status "$status" --name "$NAME" --host "$(hostname)" "${args[@]+"${args[@]}"}" \
        >/dev/null || { log "audit: could not record $event in $SPOOL"; return 1; }
    sync_events || log "audit: $event is in $SPOOL and not yet in Postgres; run: nora-computer sync-events"
    return 0
}

# A token's identity for the audit: 12 hex of its SHA-256, never the token.
token_fingerprint() {
    printf '%s' "$COMPUTERD_TOKEN" | python3 "$HERE/lifecycle_event.py" fingerprint
}

# computerd answers /v1/health, parsed as JSON rather than grepped for spacing.
healthy() {
    curl -fsS -m 3 "http://$HOST_IP:$HOST_PORT/v1/health" 2>/dev/null | python3 -c '
import json, sys
try:
    body = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
sys.exit(0 if body.get("service") == "computerd" and body.get("status") == "ok" else 1)'
}

# Healthy AND holding the current token: after a rotation the old process
# still answers /v1/health, so ask it something that needs the token. 401 means
# it runs with a stale one and must be restarted.
authorised() {
    local code
    code=$(curl -s -m 5 -o /dev/null -w '%{http_code}' \
        -H "Authorization: Bearer $COMPUTERD_TOKEN" -H 'Content-Type: application/json' \
        -d '{"scope": "0000000000000000", "pattern": "*"}' \
        "http://$HOST_IP:$HOST_PORT/v1/files")
    [ "$code" = 200 ]
}

published() {
    sbx ports "$NAME" --json </dev/null 2>/dev/null | python3 -c '
import json, sys
try:
    ports = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
want = (sys.argv[1], int(sys.argv[2]))
sys.exit(0 if any((p.get("host_ip"), p.get("host_port")) == want for p in ports) else 1)' \
        "$HOST_IP" "$HOST_PORT"
}

sandbox_state() {
    sbx ls --json </dev/null | python3 -c '
import json, sys
name = sys.argv[1]
for s in json.load(sys.stdin)["sandboxes"]:
    if s["name"] == name:
        print(s["status"]); break
else:
    print("absent")' "$NAME"
}

load_token() {
    # The last assignment wins, as in a shell or compose; surrounding quotes
    # and a CR from a file edited elsewhere are stripped.
    COMPUTERD_TOKEN=$(grep -E '^NORA_COMPUTER_TOKEN=' "$ENV_FILE" 2>/dev/null | tail -n 1 \
        | cut -d= -f2- | tr -d '\r' | sed -e 's/^["'"'"']//' -e 's/["'"'"']$//')
    [ -n "$COMPUTERD_TOKEN" ] || { log "NORA_COMPUTER_TOKEN is not set in $ENV_FILE"; exit 3; }
    export COMPUTERD_TOKEN
}

# Does sbx's own authorizer allow `$1` (host:port) from this sandbox? Prints
# allowed, denied or unknown. `sbx policy check` is read-only and "evaluates the
# same daemon-side policy authorizer used by sandbox network enforcement", so it
# is the measurement, not a grep of the rule list. Anything it does not say in
# the words below is unknown: an unreadable answer is never an allow.
egress_verdict() {
    local out first
    out=$(sbx policy check network --sandbox "$NAME" "$1" </dev/null 2>&1) \
        || { echo unknown; return; }
    first=$(printf '%s\n' "$out" | head -n 1)
    case "$first" in
        Allowed*) echo allowed ;;
        Denied*) echo denied ;;
        *) echo unknown ;;
    esac
}

# Add every EGRESS_ALLOW rule the authorizer does not already allow, then read
# each back. Idempotent: a second run adds nothing. Returns non-zero if any rule
# could not be added or does not read back as allowed.
egress_apply() {
    local res out bad=0
    for res in "${EGRESS_ALLOW[@]}"; do
        [ "$(egress_verdict "$res")" = allowed ] && continue
        out=$(sbx policy allow network --sandbox "$NAME" "$res" </dev/null 2>&1) \
            || { log "egress: allowing $res failed: $out"; bad=1; continue; }
        if [ "$(egress_verdict "$res")" = allowed ]; then
            log "egress: allowed $res for $NAME"
        else
            log "egress: $res was added but the policy does not read back as allowed"
            bad=1
        fi
    done
    return $bad
}

# The read-back, both halves: every allowlisted host is allowed, and what must
# NOT be reachable is denied. The negative cover is computerd's own published
# port (Nora's service: the VM has no business calling the thing that drives
# it), the same host on OmniRoute's port, and two arbitrary public hosts.
# Exit 0 all as required, 1 a violation, 2 a verdict sbx would not give.
egress_check() {
    local violation=0 unreadable=0 res verdict
    for res in "${EGRESS_ALLOW[@]}"; do
        verdict=$(egress_verdict "$res")
        echo "want allowed  $res  got $verdict"
        case "$verdict" in allowed) ;; unknown) unreadable=1 ;; *) violation=1 ;; esac
    done
    for res in "$HOST_IP:$HOST_PORT" "$HOST_IP:20128" example.com:443 8.8.8.8:53; do
        verdict=$(egress_verdict "$res")
        echo "want denied   $res  got $verdict"
        case "$verdict" in denied) ;; unknown) unreadable=1 ;; *) violation=1 ;; esac
    done
    [ "$violation" = 0 ] || return 1
    [ "$unreadable" = 0 ] || return 2
    return 0
}

cmd_egress() {
    [ "$(sandbox_state)" != absent ] || { log "no sandbox $NAME: create it first (serve)"; exit 6; }
    local rc
    case "${1:-}" in
        apply)
            egress_apply; rc=$?
            if [ "$rc" = 0 ]; then egress_check >/dev/null; rc=$?; fi
            if [ "$rc" = 0 ]; then
                record_event egress_apply ok allowed="${EGRESS_ALLOW[*]}"
            else
                record_event egress_apply failed rc="$rc"
            fi
            exit "$rc" ;;
        check) egress_check; exit $? ;;
        *) echo "usage: nora-computer egress apply|check" >&2; exit 2 ;;
    esac
}

cmd_build() {
    local tar
    tar=$(mktemp --suffix=.tar) || exit 1
    # --network=host: BuildKit's default bridge cannot resolve package mirrors on
    # the deploy host (operational constraint 1, the same reason every compose
    # `build:` sets it).
    docker build --network=host -t "$IMAGE" "$HERE" || { rm -f "$tar"; exit 4; }
    docker save "$IMAGE" -o "$tar" && sbx template load "$tar" </dev/null; local rc=$?
    rm -f "$tar"
    [ "$rc" = 0 ] || exit 5
    log "built and loaded $IMAGE"
}

# Create or start the sandbox and publish computerd's port. Idempotent.
prepare() {
    if [ "$(sandbox_state)" = absent ]; then
        # DETACHED (`sbx run -d`), and only at creation: sandboxd stops a
        # non-detached local sandbox 30 s after its last session disconnects,
        # whatever still runs inside (measured 2026-09-30, 73 of 73 stops at
        # 30.06-30.12 s; not configurable, TTL is cloud-only). A detached one
        # is never auto-stopped ("session disconnected (detached; not
        # auto-stopping)"). The flag is set at create time only, so a sandbox
        # made by `sbx create` must be destroyed and recreated.
        # `sbx run` needs a primary workspace, read-write by rule: an empty
        # dedicated host directory that nothing on the host ever reads.
        mkdir -p "$UNUSED_WORKSPACE" && chmod 700 "$UNUSED_WORKSPACE"
        log "creating $NAME (detached) from $IMAGE"
        if ! sbx run -d --name "$NAME" -m "$MEMORY" --cpus "$CPUS" --pull never -t "$IMAGE" \
            -p "$HOST_IP:$HOST_PORT:80" shell "$UNUSED_WORKSPACE" \
            </dev/null >/dev/null; then
            record_event create failed image="$IMAGE"
            log "create failed"
            exit 6
        fi
        # A create after an earlier one is a RECREATE: /workspace was lost to it
        # (README, "Backup and restore"). The marker is the earlier create's time.
        if [ -s "$STATE_DIR/created-at" ]; then
            record_event recreate ok image="$IMAGE" previous_create="$(cat "$STATE_DIR/created-at")"
        else
            record_event create ok image="$IMAGE"
        fi
        date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE_DIR/created-at"
    fi
    # A published port survives a stop, and `sbx ports` lists nothing while
    # the sandbox is stopped, so a publish can answer 409 "already
    # published": that is the state we want, not a failure.
    if ! published; then
        local out
        out=$(sbx ports "$NAME" --publish "$HOST_IP:$HOST_PORT:80" </dev/null 2>&1) \
            || echo "$out" | grep -q "already published" \
            || { log "publish failed: $out"; exit 7; }
    fi
    # The egress allowlist is applied on EVERY prepare, not only on a create: a
    # rule lives in sbx's daemon, not in the VM, so a recreate or a reset of the
    # policy store loses it while the unit keeps running. NOT fatal: computerd
    # serves without package egress (deny-all just refuses the fetch), and a
    # crash-looping unit over a policy word would take the whole computer down
    # for a read-back problem. `status` and `egress check` say it is missing.
    egress_apply || log "egress: the allowlist is NOT in place; run: nora-computer egress apply"
}

# The long-running mode systemd supervises (nora-computer.service,
# Restart=always). computerd runs in the foreground of an `sbx exec` session,
# so systemd sees it die and restarts it. The sandbox itself is detached (see
# `prepare`), so its life no longer depends on this session: killing this
# process ends computerd, not the VM. A token change takes effect on
# `systemctl --user restart nora-computer`.
cmd_serve() {
    load_token
    exec 9>"$LOCK"
    flock -w 60 9 || { log "another serve or prepare holds $LOCK"; exit 75; }
    prepare
    exec 9>&-
    sbx exec -u root "$NAME" pkill -f /opt/computerd/computerd.py </dev/null >/dev/null 2>&1 || true
    # Every serve start is a computerd (re)start: the unit restarting it after
    # a crash, a token rotation, a deploy, a reboot. A rotation is the token's
    # fingerprint differing from the one the last start saw; the first start
    # has nothing to differ from and records only the start.
    local fp previous=""
    fp=$(token_fingerprint) || fp=unknown
    [ -s "$STATE_DIR/token.fingerprint" ] && previous=$(cat "$STATE_DIR/token.fingerprint")
    if [ -n "$previous" ] && [ "$previous" != "$fp" ]; then
        record_event token_rotation ok previous_fingerprint="$previous" fingerprint="$fp"
    fi
    mkdir -p "$STATE_DIR" && printf '%s\n' "$fp" > "$STATE_DIR/token.fingerprint"
    record_event computerd_start ok token_fingerprint="$fp" invocation="${INVOCATION_ID:-manual}"
    log "serving computerd in the foreground"
    # As root, so commands (each room's as its own user) cannot read its
    # token, kill it or take its port 80. `-e COMPUTERD_TOKEN` passes the
    # value from this environment, so it never appears on a command line.
    exec sbx exec -u root -e COMPUTERD_TOKEN "$NAME" \
        /opt/computerd/venv/bin/python /opt/computerd/computerd.py --root /workspace --port 80 \
        </dev/null
}

cmd_status() {
    local health=down egress=n/a state
    load_token
    healthy && health=up && authorised && health=healthy
    state=$(sandbox_state)
    # ok only when every allowlisted host reads back allowed AND every denied
    # probe reads back denied; `egress check` prints which one is not.
    if [ "$state" != absent ]; then
        egress_check >/dev/null
        case $? in 0) egress=ok ;; 1) egress=WRONG ;; *) egress=unknown ;; esac
    fi
    echo "sandbox=$state computerd=$health egress=$egress endpoint=http://$HOST_IP:$HOST_PORT"
}

# Reading what the network refused is an audited read: the policy log shows what
# the VM tried to reach, which is the network half of the audit (design sec 8).
cmd_policy_log() {
    local rc
    record_event policy_log_read ok args="$*" || exit 5
    sbx policy log "$NAME" "$@" </dev/null; rc=$?
    exit "$rc"
}

# destroy removes the VM and its disk. The row says it happened; a failed
# removal is recorded as failed, and a removal that could not be recorded exits
# non-zero so nobody reads silence as "audited".
cmd_destroy() {
    local rc
    sbx rm --force "$NAME" </dev/null; rc=$?
    if [ "$rc" = 0 ]; then
        record_event destroy ok || { log "audit: $NAME was destroyed and the event could NOT be recorded"; exit 5; }
    else
        record_event destroy failed rc="$rc"
    fi
    exit "$rc"
}

case "${1:-}" in
    build) cmd_build ;;
    serve) cmd_serve ;;
    status) cmd_status ;;
    egress) shift; cmd_egress "$@" ;;
    policy-log) shift; cmd_policy_log "$@" ;;
    sync-events) sync_events; exit $? ;;
    stop) sbx stop "$NAME" </dev/null ;;
    destroy) cmd_destroy ;;
    *) echo "usage: nora-computer build|serve|status|egress|policy-log|sync-events|stop|destroy" >&2; exit 2 ;;
esac
