[Unit]
Description=Nora social session health probe (Chrome owns the sessions, the bridge follows)
After=nora-social-chrome.service

[Service]
Type=oneshot
# Same rationale as nora-social-bridge.service: the systemd USER environment
# has no interactive PATH, so opencli must be named explicitly and node must be
# resolvable on PATH.
Environment="NORA_PROBE_CHROME_DB=%h/.local/share/nora-browser/Profile 1/Cookies"
Environment=NORA_PROBE_BRIDGE_DIR=%h/workspace/nora/state/instagram
Environment=OPENCLI_BIN=%h/.local/bin/opencli
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin:%h/.local/bin:%h/.hermes/node/bin
# Exit 1 = FAIL (an alert fired or a sync ran): the probe did its job, the unit
# is not failed. Exit 2 = ERROR (could not measure): the unit IS failed, so
# `systemctl --user --failed` shows an unmeasured probe.
SuccessExitStatus=1
TimeoutStartSec=600
# Names the unit's stdout in the journal: the SigNoz ingester's journald
# receiver selects probe entries on SYSLOG_IDENTIFIER=nora-session-probe
# (journald match list in deploy/signoz/deployment/ingester/ingester.yaml).
SyslogIdentifier=nora-session-probe
ExecStart=%h/.local/bin/uv run --project %h/workspace/nora python -m nora.infra.social.session_probe
