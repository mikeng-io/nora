[Unit]
Description=Nora social read-only bridge (OpenCLI)
After=nora-social-chrome.service

[Service]
Type=simple
# opencli is a node script (shebang `#!/usr/bin/env node`) under
# ~/.hermes/node (symlinked into ~/.local/bin). The systemd USER service
# environment does NOT carry the interactive shell's PATH (no ~/.local/bin,
# no ~/.hermes/node/bin): the binary must be named explicitly AND node must
# be resolvable on PATH, or the spawn fails (FileNotFoundError on `opencli`,
# then `env: 'node': No such file or directory` once the binary is found).
Environment=OPENCLI_BIN=%h/.local/bin/opencli
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin:%h/.local/bin:%h/.hermes/node/bin
# Nora's container is NOT on host networking — it is on the private compose
# `nora` network and reaches the host via host.docker.internal, which resolves
# to the docker0 gateway (172.17.0.1). Binding loopback alone made the bridge
# unreachable from the container; binding the docker0 gateway too keeps it off
# the LAN (docker0 is host-internal) while making /read reachable at
# http://host.docker.internal:19826. No auth on /read; the allowlist is the
# boundary (see nora/infra/social/bridge_server.py).
Environment=NORA_SOCIAL_BRIDGE_HOST=127.0.0.1,172.17.0.1
ExecStart=%h/.local/bin/uv run --project %h/workspace/nora python -m nora.infra.social
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
