{
  "route": "POST /threads/{thread_fbid}/messages",
  "path": "/threads/not-a-thread/messages",
  "request": {
    "mentions": [
      {
        "fbid": "100000000000001",
        "length": 15,
        "offset": 0
      }
    ],
    "reply_to": "mid.$syntheticparent",
    "text": "@example_friend synthetic message text"
  },
  "upstream": [],
  "status": 400,
  "body": {
    "error": {
      "code": "invalid_id",
      "message": "thread_fbid must be a positive decimal thread id (the SHORT id)"
    }
  }
}
