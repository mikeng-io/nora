    {
      "id": "claim_0305393bf2cc4b07969ba34415a2337a",
      "statement": "The ambient majority of messages ends without a turn: `IngestResult` carries the message and `EngageDecision`, the ordinary pass is recorded as `recorded`, and a tag from a sender absent from the room's `persons` list is recorded but downgraded to `sender_not_allowed` rather than answered.",
      "evidence": [
        {
          "resource": "repo://nora/ingest/pipeline.py#L415-L437",
          "version": "repo-lines-v1:sha256:71c4789dd76041da7a9081093bfbcb0486dad9d5214a51f5a6f099b91604dab3:"
