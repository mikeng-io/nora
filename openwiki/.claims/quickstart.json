    {
      "id": "claim_99b1439174f6422787b67fa6ddd5ecf5",
      "statement": "Nora's continuity belongs to persistent state rather than an open chat session: each speaking turn constructs a fresh Strands agent from assembled context with no SDK session manager, while background cognition and computer work use their own bounded sessions.",
      "evidence": [
        {
          "resource": "repo://ARCHITECTURE.md#L8-L15",
          "version": "repo-lines-v1:sha256:16f8a08137942ab5780b116a77fd59ba80fb6a3915ba5636eeb4bb8b1f82ebad:"
