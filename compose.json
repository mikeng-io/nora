        "NORA_BRIDGE_API_TOKEN=${NORA_BRIDGE_API_TOKEN:-${NORA_BRIDGE_TOKEN:?set NORA_BRIDGE_API_TOKEN in .env}}",
        "NORA_BRIDGE_CORRELATION_KEY=${NORA_BRIDGE_CORRELATION_KEY:?}",
        "NORA_BRIDGE_CORRELATION_KEY_VERSION=${NORA_BRIDGE_CORRELATION_KEY_VERSION:-1}",
        "NORA_BRIDGE_ACCOUNT_KEY=${DISCORD_BRIDGE_ACCOUNT_KEY:?set DISCORD_BRIDGE_ACCOUNT_KEY in .env}",
        "NORA_BRIDGE_JOURNAL=/data/bridge/journal/discord.jsonl",
        "DATABASE_URL=postgresql+asyncpg://nora:${POSTGRES_PASSWORD:?}@db:5432/nora",
        "NORA_BRIDGE_ATTACH_DIR=/data/bridge/attachments",
        "NORA_BRIDGE_PORT=18093"
      ],
      "command": [
        "--config",
