      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "printf 'Authorization: Bearer %s\\n' \"$$NORA_BRIDGE_API_TOKEN\" | curl -fsS -m 5 -H @- http://127.0.0.1:18093/v1/health || exit 1"
