        "${NORA_RUNTIME_ROOT:?}/config.toml:/app/config.toml:ro",
        "${NORA_RUNTIME_ROOT:?}/identity.toml:/app/identity.toml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:9101/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "20s",
        "retries": 3
      }
    },
    "analytics": {
      "image": "ghcr.io/mikeng-io/nora-nora@sha256:2a601e2a339a4a1f74b3a23e5622480e329e871dcba748c01e7181868839dbff",
      "container_name": "analytics",
      "restart": "unless-stopped",
      "entrypoint": [
        "uv",
        "run",
        "--no-sync",
        "python",
        "-m",
        "nora.analytics"
      ],
      "command": [
        "--config",
        "config.toml"
      ],
      "networks": [
        "nora"
      ],
      "ports": [
        "127.0.0.1:9103:9103"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "environment": [
        "DATABASE_URL=postgresql+asyncpg://nora:${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}@db/nora",
        "TZ=Asia/Hong_Kong"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/config.toml:/app/config.toml:ro",
        "${NORA_RUNTIME_ROOT:?}/identity.toml:/app/identity.toml:ro",
        "${NORA_RUNTIME_ROOT:?}/policy.toml:/app/policy.toml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:9103/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "20s",
        "retries": 3
      }
    },
    "rustfs": {
      "image": "rustfs/rustfs:1.0.0-rc.1",
      "container_name": "rustfs",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "environment": [
        "RUSTFS_ROOT_USER=${RUSTFS_ROOT_USER:?set RUSTFS_ROOT_USER in .env}",
        "RUSTFS_ROOT_PASSWORD=${RUSTFS_ROOT_PASSWORD:?set RUSTFS_ROOT_PASSWORD in .env}"
      ],
      "volumes": [
        "rustfs-data:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -sS -o /dev/null http://127.0.0.1:9000/ || exit 1"
        ],
        "interval": "10s",
        "timeout": "5s",
        "start_period": "20s",
        "retries": 5
      }
    },
    "embedder": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "ghcr.io/ggml-org/llama.cpp:server-b11541@sha256:bf3da52e92c083472b3d1c9f9da081f423ab9def95a87ec4bba51940382d75fd",
      "container_name": "embedder",
      "restart": "unless-stopped",
      "profiles": [
        "embedder"
      ],
      "networks": [
        "embedder",
        "embedder_host"
      ],
      "ports": [
        "127.0.0.1:8092:8080"
      ],
      "environment": [
        "LLAMA_MEDIA_MARKER=<__media__>"
      ],
      "command": [
        "--embedding",
        "--pooling",
        "last",
        "-m",
        "/models/Qwen3-VL-Embedding-2B.Q4_K_M.gguf",
        "--mmproj",
        "/models/Qwen3-VL-Embedding-2B.mmproj-f16.gguf",
        "-c",
        "2048",
        "-b",
        "2048",
        "-ub",
        "2048",
        "-t",
        "4",
        "-ngl",
        "0",
        "--parallel",
        "1",
        "--host",
        "0.0.0.0",
        "--port",
        "8080"
      ],
      "cpus": 4,
      "mem_limit": "4g",
      "memswap_limit": "4g",
      "volumes": [
        "${EMBEDDER_MODELS_DIR:-${NORA_RUNTIME_ROOT:?}/models/embedder}:/models:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:8080/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "120s",
        "retries": 3
      }
    },
    "db": {
      "image": "pgvector/pgvector:pg18",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "ports": [
        "127.0.0.1:5435:5432"
      ],
      "environment": {
        "POSTGRES_USER": "nora",
        "POSTGRES_DB": "nora",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}"
      },
      "volumes": [
        "db-data:/var/lib/postgresql"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U nora -d nora"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    "stt": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "ghcr.io/mikeng-io/nora-stt@sha256:835f9f445e956d0c776b3e0394abc1da65aeaf6ed8e815200bb6e9dbe15e3fa3",
      "container_name": "stt",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "mem_limit": "8g",
      "memswap_limit": "8g",
      "volumes": [
        "stt-modelscope-cache:/home/stt/.cache/modelscope",
        "stt-huggingface-cache:/home/stt/.cache/huggingface",
        "${NORA_RUNTIME_ROOT:?}/config.toml:/app/config.toml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:8000/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "900s",
        "retries": 3
      }
    },
    "voice-sidecar": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "ghcr.io/mikeng-io/nora-voice-sidecar@sha256:32b08f8a605074ebcbec539c2342d6301bd780b754412f8726e8d61f17083c8a",
      "container_name": "voice-sidecar",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "environment": [
        "DISCORD_BOT_TOKEN=${DISCORD_BOT_TOKEN:-}",
        "NORA_BRIDGE_TOKEN=${NORA_BRIDGE_TOKEN:?set NORA_BRIDGE_TOKEN in the host environment first}",
        "PUMP_HOST=${VOICE_PUMP_HOST:-voice-wake}",
        "PUMP_PORT=${VOICE_PUMP_PORT:-4599}",
        "HOST=0.0.0.0",
        "STATE_DIR=/var/lib/audio-controller",
        "NORA_EVENT_URL=http://discord-bridge:18093/v1/voice/event"
      ],
      "volumes": [
        "audio-controller-state:/var/lib/audio-controller",
        "${NORA_RUNTIME_ROOT:?}/config.toml:/app/config.toml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "printf 'Authorization: Bearer %s\\n' \"$$NORA_BRIDGE_TOKEN\" | curl -fsS -m 5 -H @- http://127.0.0.1:$${PORT:-4600}/health || exit 1"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "60s",
        "retries": 3
      }
    },
    "voice-wake": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "ghcr.io/mikeng-io/nora-voice-wake@sha256:353183e8aad06ac780830ff657a1afb5505fdb2eb13ceca82279a8f2579a7db4",
      "container_name": "voice-wake",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "mem_limit": "2g",
      "memswap_limit": "2g",
      "environment": [
        "NORA_BRIDGE_TOKEN=${NORA_BRIDGE_TOKEN:?set NORA_BRIDGE_TOKEN in the host environment first}",
        "NORA_INGEST_URL=http://nora:9100"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/config.toml:/app/config.toml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:4601/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "60s",
        "retries": 3
      }
    }
  },
  "networks": {
    "nora": null,
    "honcho": {
      "external": true,
      "name": "honcho_memory"
    },
    "embedder": {
