{
  "services": {
    "signal-cli": {
      "image": "ghcr.io/mikeng-io/nora-signal-cli@sha256:771d7989ebc3ffcb5f617dbe54a6c43dd0dd4aca98c3d7dee1575552e3a19bb2",
      "container_name": "signal-cli",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/state/signal-cli:/data/signal-cli"
      ],
      "environment": [
        "XDG_DATA_HOME=/data"
      ],
      "command": [
        "--account",
        "${SIGNAL_ACCOUNT:?set SIGNAL_ACCOUNT in .env}",
        "daemon",
        "--http",
        "0.0.0.0:18080",
        "--receive-mode",
        "on-start"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS -m 5 -X POST http://127.0.0.1:18080/api/v1/rpc -H 'Content-Type: application/json' -d '{\"jsonrpc\":\"2.0\",\"id\":\"hc\",\"method\":\"version\",\"params\":{}}' | grep -q '\"version\"' || exit 1"
        ],
        "interval": "60s",
        "timeout": "10s",
        "start_period": "60s",
        "retries": 3
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "whatsapp-bridge": {
      "image": "ghcr.io/mikeng-io/nora-whatsapp-bridge@sha256:4ac74d6bf6fd7fef119a80c7128b2e121b876ef03eb82f8a7c3be5f11e3d60b8",
      "container_name": "whatsapp-bridge",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/state/whatsapp:/app/session"
      ],
      "environment": [
        "NORA_BRIDGE_TOKEN=${NORA_BRIDGE_TOKEN:?set NORA_BRIDGE_TOKEN in the host environment first}"
      ],
      "command": [
        "node",
        "bridge.js",
        "--port",
        "18081",
        "--session",
        "/app/session"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS -m 5 http://127.0.0.1:18081/health || exit 1"
        ],
        "interval": "60s",
        "timeout": "10s",
        "start_period": "60s",
        "retries": 3
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "instagram-bridge": {
      "image": "ghcr.io/mikeng-io/nora-instagram-bridge@sha256:d2925716e1ef41ca93c053b0b4d54c7e2f579cfc749ef4560aa91f99b17f2092",
      "container_name": "instagram-bridge",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/state/instagram:/session"
      ],
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "environment": [
        "IG_SESSION_DIR=/session",
        "NORA_BRIDGE_TOKEN=${NORA_BRIDGE_TOKEN:?set NORA_BRIDGE_TOKEN in the host environment first}",
        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces",
        "OTEL_SERVICE_NAME=instagram-bridge",
        "INSTAGRAM_COMMENT_WRITES=${INSTAGRAM_COMMENT_WRITES:-off}",
        "INSTAGRAM_COMMENT_DAILY_CAP=${INSTAGRAM_COMMENT_DAILY_CAP:-10}",
        "INSTAGRAM_COMMENT_MIN_INTERVAL=${INSTAGRAM_COMMENT_MIN_INTERVAL:-90s}",
        "INSTAGRAM_STORY_DOC_ID=${INSTAGRAM_STORY_DOC_ID:-}",
        "INSTAGRAM_TIMELINE_DOC_ID=${INSTAGRAM_TIMELINE_DOC_ID:-}"
      ],
      "command": [
        "--port",
        "18082",
        "--session",
        "/session"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "printf 'Authorization: Bearer %s\\n' \"$$NORA_BRIDGE_TOKEN\" | curl -fsS -m 5 -H @- http://127.0.0.1:18082/health || exit 1"
        ],
        "interval": "60s",
        "timeout": "10s",
        "start_period": "60s",
        "retries": 3
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "nora": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "ghcr.io/mikeng-io/nora-nora@sha256:895d776d96f55f1aa5c1a2d3f5860b2c04c02f085bddba7693498a486a70822f",
      "container_name": "nora",
      "restart": "unless-stopped",
      "stop_grace_period": "75s",
      "networks": [
        "nora",
        "honcho",
        "embedder"
      ],
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "ports": [
        "127.0.0.1:9100:9100"
      ],
      "depends_on": {
        "signal-cli": {
          "condition": "service_healthy"
        },
        "db": {
          "condition": "service_healthy"
        }
      },
      "environment": [
        "OMNIROUTE_API_KEY=${OMNIROUTE_API_KEY:?set OMNIROUTE_API_KEY in the host environment first}",
        "NORA_BRIDGE_TOKEN=${NORA_BRIDGE_TOKEN:?set NORA_BRIDGE_TOKEN in the host environment first}",
        "DATABASE_URL=postgresql+asyncpg://nora:${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}@db/nora",
        "LANGFUSE_OTLP_HEADERS=${LANGFUSE_OTLP_HEADERS:-}",
        "SENTRY_DSN=${SENTRY_DSN:-}",
        "GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY:-}",
        "MEDIA_ENCRYPTION_KEY=${MEDIA_ENCRYPTION_KEY:-}",
        "LIFE360_USERNAME=${LIFE360_USERNAME:-}",
        "LIFE360_PASSWORD=${LIFE360_PASSWORD:-}",
        "LIFE360_AUTH_TOKEN=${LIFE360_AUTH_TOKEN:-}",
        "RUSTFS_ROOT_USER=${RUSTFS_ROOT_USER:-}",
        "RUSTFS_ROOT_PASSWORD=${RUSTFS_ROOT_PASSWORD:-}",
        "NORA_COMPUTER_TOKEN=${NORA_COMPUTER_TOKEN:-}",
        "NORA_OTP_SECRET=${NORA_OTP_SECRET:-}",
        "NORA_OTP_API_TOKEN=${NORA_OTP_API_TOKEN:-}",
        "HKGOV_MAPS_TOKEN=${HKGOV_MAPS_TOKEN:-}",
        "GOOGLE_OAUTH_CLIENT_ID=${GOOGLE_OAUTH_CLIENT_ID:-}",
        "GOOGLE_OAUTH_CLIENT_SECRET=${GOOGLE_OAUTH_CLIENT_SECRET:-}",
        "GOOGLE_OAUTH_REFRESH_TOKEN=${GOOGLE_OAUTH_REFRESH_TOKEN:-}",
        "TAVILY_API_KEY=${TAVILY_API_KEY:-}",
        "EXA_API_KEY=${EXA_API_KEY:-}",
        "STEAM_WEB_API_KEY=${STEAM_WEB_API_KEY:-}",
        "GIPHY_API_KEY=${GIPHY_API_KEY:-}",
        "KIMI_CODE_API_KEY=${KIMI_CODE_API_KEY:-}",
        "OPENCODE_GO_API_KEY=${OPENCODE_GO_API_KEY:-}",
        "XAI_OAUTH_REFRESH_TOKEN=${XAI_OAUTH_REFRESH_TOKEN:-}",
        "OPENAI_CODEX_REFRESH_TOKEN=${OPENAI_CODEX_REFRESH_TOKEN:-}",
        "DISCORD_BOT_TOKEN=${DISCORD_BOT_TOKEN:-}",
        "MINIMAX_CN_API_KEY=${MINIMAX_CN_API_KEY:-}",
        "PULSE_MCP_TOKEN=${PULSE_MCP_TOKEN:-}",
        "PULSE_API_TOKEN=${PULSE_API_TOKEN:-}",
        "PULSE_API_BASE=${PULSE_API_BASE:-}",
        "TZ=Asia/Hong_Kong"
      ],
      "volumes": [
        "${NORA_DATA_HOST_ROOT:-${NORA_RUNTIME_ROOT:?}/data}:/app/data",
        "${NORA_RUNTIME_ROOT:?}/state:/app/state",
        "${NORA_RUNTIME_ROOT:?}/config.toml:/app/config.toml:ro",
        "${NORA_RUNTIME_ROOT:?}/identity.toml:/app/identity.toml:ro",
        "${NORA_RUNTIME_ROOT:?}/policy.toml:/app/policy.toml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:9100/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "20s",
        "retries": 3
      }
    },
    "app": {
      "image": "ghcr.io/mikeng-io/nora-app@sha256:30b6d5576ab8988d4e74a783a1976ef40bc2953929067fc4668bf5f7f28c7a3b",
      "container_name": "nora-app",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "ports": [
        "127.0.0.1:3400:3000"
      ],
      "depends_on": {
        "nora": {
          "condition": "service_healthy"
        }
      },
      "environment": [
        "NORA_API_BASE=http://nora:9100",
        "AUTH_DISCORD_ID=${DISCORD_CLIENT_ID:?set DISCORD_CLIENT_ID in the host environment first}",
        "AUTH_DISCORD_SECRET=${DISCORD_CLIENT_SECRET:?set DISCORD_CLIENT_SECRET in the host environment first}",
        "AUTH_SECRET=${AUTH_SECRET:?set AUTH_SECRET in the host environment first}",
        "AUTH_URL=${AUTH_URL:?set AUTH_URL (the public origin, e.g. https://nora.67.zone) in the host environment first}",
        "NORA_OTP_API_TOKEN=${NORA_OTP_API_TOKEN:-}"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/identity.toml:/app/identity.toml:ro"
      ]
    },
    "site": {
      "image": "ghcr.io/mikeng-io/nora-site@sha256:24915f2b079b9941caa18926b47905e0ff81084ff017030f46fd2aa29d1d0819",
      "container_name": "nora-site",
      "profiles": [
        "site"
      ],
      "restart": "unless-stopped",
      "ports": [
        "127.0.0.1:3401:8080"
      ]
    },
    "presence": {
      "image": "ghcr.io/mikeng-io/nora-nora@sha256:895d776d96f55f1aa5c1a2d3f5860b2c04c02f085bddba7693498a486a70822f",
      "container_name": "presence",
      "restart": "unless-stopped",
      "entrypoint": [
        "uv",
        "run",
        "--no-sync",
        "python",
        "-m",
        "nora.presence"
      ],
      "command": [
        "--config",
        "config.toml"
      ],
      "networks": [
        "nora"
      ],
      "ports": [
        "127.0.0.1:9101:9101"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "environment": [
        "DATABASE_URL=postgresql+asyncpg://nora:${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}@db/nora",
        "LIFE360_CLIENT_CREDENTIAL=${LIFE360_CLIENT_CREDENTIAL:-}",
        "LIFE360_USERNAME=${LIFE360_USERNAME:-}",
        "LIFE360_PASSWORD=${LIFE360_PASSWORD:-}",
        "LIFE360_AUTH_TOKEN=${LIFE360_AUTH_TOKEN:-}",
        "TZ=Asia/Hong_Kong"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/config.toml:/app/config.toml:ro",
        "${NORA_RUNTIME_ROOT:?}/identity.toml:/app/identity.toml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:9101/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "20s",
        "retries": 3
      }
    },
    "analytics": {
      "image": "ghcr.io/mikeng-io/nora-nora@sha256:895d776d96f55f1aa5c1a2d3f5860b2c04c02f085bddba7693498a486a70822f",
      "container_name": "analytics",
      "restart": "unless-stopped",
      "entrypoint": [
        "uv",
        "run",
        "--no-sync",
        "python",
        "-m",
        "nora.analytics"
      ],
      "command": [
        "--config",
        "config.toml"
      ],
      "networks": [
        "nora"
      ],
      "ports": [
        "127.0.0.1:9103:9103"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "environment": [
        "DATABASE_URL=postgresql+asyncpg://nora:${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}@db/nora",
        "TZ=Asia/Hong_Kong"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/config.toml:/app/config.toml:ro",
        "${NORA_RUNTIME_ROOT:?}/identity.toml:/app/identity.toml:ro",
        "${NORA_RUNTIME_ROOT:?}/policy.toml:/app/policy.toml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:9103/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "20s",
        "retries": 3
      }
    },
    "rustfs": {
      "image": "rustfs/rustfs:1.0.0-rc.1",
      "container_name": "rustfs",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "environment": [
        "RUSTFS_ROOT_USER=${RUSTFS_ROOT_USER:?set RUSTFS_ROOT_USER in .env}",
        "RUSTFS_ROOT_PASSWORD=${RUSTFS_ROOT_PASSWORD:?set RUSTFS_ROOT_PASSWORD in .env}"
      ],
      "volumes": [
        "rustfs-data:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -sS -o /dev/null http://127.0.0.1:9000/ || exit 1"
        ],
        "interval": "10s",
        "timeout": "5s",
        "start_period": "20s",
        "retries": 5
      }
    },
    "embedder": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "ghcr.io/ggml-org/llama.cpp:server-b11541@sha256:bf3da52e92c083472b3d1c9f9da081f423ab9def95a87ec4bba51940382d75fd",
      "container_name": "embedder",
      "restart": "unless-stopped",
      "profiles": [
        "embedder"
      ],
      "networks": [
        "embedder",
        "embedder_host"
      ],
      "ports": [
        "127.0.0.1:8092:8080"
      ],
      "environment": [
        "LLAMA_MEDIA_MARKER=<__media__>"
      ],
      "command": [
        "--embedding",
        "--pooling",
        "last",
        "-m",
        "/models/Qwen3-VL-Embedding-2B.Q4_K_M.gguf",
        "--mmproj",
        "/models/Qwen3-VL-Embedding-2B.mmproj-f16.gguf",
        "-c",
        "2048",
        "-b",
        "2048",
        "-ub",
        "2048",
        "-t",
        "4",
        "-ngl",
        "0",
        "--parallel",
        "1",
        "--host",
        "0.0.0.0",
        "--port",
        "8080"
      ],
      "cpus": 4,
      "mem_limit": "4g",
      "memswap_limit": "4g",
      "volumes": [
        "${EMBEDDER_MODELS_DIR:-${NORA_RUNTIME_ROOT:?}/models/embedder}:/models:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:8080/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "120s",
        "retries": 3
      }
    },
    "db": {
      "image": "pgvector/pgvector:pg18",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "ports": [
        "127.0.0.1:5435:5432"
      ],
      "environment": {
        "POSTGRES_USER": "nora",
        "POSTGRES_DB": "nora",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}"
      },
      "volumes": [
        "db-data:/var/lib/postgresql"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U nora -d nora"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    "stt": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "ghcr.io/mikeng-io/nora-stt@sha256:d3ef7c78cf3bdfb35e4bd3c0b8d71abb60b7df7063ee93d00d5fb1a909f554ed",
      "container_name": "stt",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "mem_limit": "8g",
      "memswap_limit": "8g",
      "volumes": [
        "stt-modelscope-cache:/home/stt/.cache/modelscope",
        "stt-huggingface-cache:/home/stt/.cache/huggingface",
        "${NORA_RUNTIME_ROOT:?}/config.toml:/app/config.toml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:8000/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "900s",
        "retries": 3
      }
    },
    "voice-sidecar": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "ghcr.io/mikeng-io/nora-voice-sidecar@sha256:b94af469b23cb25080b676d779f81933d88056bbc02d2d39e242fadfc8e207a9",
      "container_name": "voice-sidecar",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "environment": [
        "DISCORD_BOT_TOKEN=${DISCORD_BOT_TOKEN:-}",
        "NORA_BRIDGE_TOKEN=${NORA_BRIDGE_TOKEN:?set NORA_BRIDGE_TOKEN in the host environment first}",
        "PUMP_HOST=${VOICE_PUMP_HOST:-voice-wake}",
        "PUMP_PORT=${VOICE_PUMP_PORT:-4599}",
        "HOST=0.0.0.0",
        "STATE_DIR=/var/lib/audio-controller",
        "NORA_EVENT_URL=http://nora:9100/app/v1/voice/event"
      ],
      "volumes": [
        "audio-controller-state:/var/lib/audio-controller",
        "${NORA_RUNTIME_ROOT:?}/config.toml:/app/config.toml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "printf 'Authorization: Bearer %s\\n' \"$$NORA_BRIDGE_TOKEN\" | curl -fsS -m 5 -H @- http://127.0.0.1:$${PORT:-4600}/health || exit 1"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "60s",
        "retries": 3
      }
    },
    "voice-wake": {
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "ghcr.io/mikeng-io/nora-voice-wake@sha256:128e2a6ad387e467fbf1fea662baa682dd4d6581b4f9faecd2d97e36c9eb0e01",
      "container_name": "voice-wake",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "mem_limit": "2g",
      "memswap_limit": "2g",
      "environment": [
        "NORA_BRIDGE_TOKEN=${NORA_BRIDGE_TOKEN:?set NORA_BRIDGE_TOKEN in the host environment first}",
        "NORA_INGEST_URL=http://nora:9100"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/config.toml:/app/config.toml:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:4601/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "start_period": "60s",
        "retries": 3
      }
    },
    "prometheus": {
      "image": "prom/prometheus:v3.13.5",
      "container_name": "nora-prometheus",
      "restart": "unless-stopped",
      "command": [
        "--config.file=/etc/prometheus/prometheus.yml",
        "--storage.tsdb.path=/prometheus",
        "--storage.tsdb.retention.time=30d",
        "--web.enable-lifecycle"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/deploy/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro",
        "${NORA_RUNTIME_ROOT:?}/deploy/prometheus/rules:/etc/prometheus/rules:ro",
        "prometheus-data:/prometheus"
      ],
      "networks": [
        "nora"
      ],
      "ports": [
        "127.0.0.1:9190:9090"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-qO-",
          "http://localhost:9090/-/healthy"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3
      }
    },
    "alertmanager": {
      "image": "prom/alertmanager:v0.28.1",
      "container_name": "nora-alertmanager",
      "restart": "unless-stopped",
      "environment": [
        "NORA_BRIDGE_TOKEN=${NORA_BRIDGE_TOKEN:?set NORA_BRIDGE_TOKEN in the host environment first}"
      ],
      "entrypoint": [
        "/bin/sh",
        "-c",
        "umask 077 && printf '%s' \"$$NORA_BRIDGE_TOKEN\" > /run/alertmanager/bridge-token && exec /bin/alertmanager \"$$@\"",
        "alertmanager"
      ],
      "command": [
        "--config.file=/etc/alertmanager/alertmanager.yml",
        "--storage.path=/alertmanager"
      ],
      "tmpfs": [
        "/run/alertmanager"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/deploy/alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro",
        "alertmanager-data:/alertmanager"
      ],
      "networks": [
        "nora"
      ],
      "ports": [
        "127.0.0.1:9193:9093"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-qO-",
          "http://localhost:9093/-/healthy"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3
      }
    },
    "alert-bridge": {
