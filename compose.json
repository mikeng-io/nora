{
  "services": {
    "redis": {
      "image": "redis:7.4-alpine@sha256:8da19c7399dca900c6822a1cf30f9d2285585e2c4b457ff4095b0f4500054d3f",
      "container_name": "nora-redis",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "environment": [
        "NORA_REDIS_PRODUCER_PASSWORD=${NORA_REDIS_PRODUCER_PASSWORD:?set NORA_REDIS_PRODUCER_PASSWORD in .env}",
        "NORA_REDIS_CONSUMER_PASSWORD=${NORA_REDIS_CONSUMER_PASSWORD:?set NORA_REDIS_CONSUMER_PASSWORD in .env}",
        "NORA_REDIS_INSPECTOR_PASSWORD=${NORA_REDIS_INSPECTOR_PASSWORD:?set NORA_REDIS_INSPECTOR_PASSWORD in .env}"
      ],
      "entrypoint": [
        "/bin/sh",
        "-c",
        "umask 077 && case \"$NORA_REDIS_PRODUCER_PASSWORD\" in *[!A-Za-z0-9_-]*|'') echo 'nora-redis: NORA_REDIS_PRODUCER_PASSWORD must match [A-Za-z0-9_-]+ (the generated secrets.token_urlsafe charset): it lands in a redis://user:pass@ URL and an ACL >-field' >&2; exit 1 ;; esac && case \"$NORA_REDIS_CONSUMER_PASSWORD\" in *[!A-Za-z0-9_-]*|'') echo 'nora-redis: NORA_REDIS_CONSUMER_PASSWORD must match [A-Za-z0-9_-]+ (the generated secrets.token_urlsafe charset): it lands in a redis://user:pass@ URL and an ACL >-field' >&2; exit 1 ;; esac && case \"$NORA_REDIS_INSPECTOR_PASSWORD\" in *[!A-Za-z0-9_-]*|'') echo 'nora-redis: NORA_REDIS_INSPECTOR_PASSWORD must match [A-Za-z0-9_-]+ (the generated secrets.token_urlsafe charset): it lands in a redis://user:pass@ URL and an ACL >-field' >&2; exit 1 ;; esac && printf '%s\\n' 'user default off' \"user nq-producer on >$$NORA_REDIS_PRODUCER_PASSWORD ~nq:* +xadd +set +get +eval +evalsha +script|load +xgroup|create +ping\" \"user nq-consumer on >$$NORA_REDIS_CONSUMER_PASSWORD ~nq:* +xreadgroup +xack +xautoclaim +xpending +xinfo +xrange +xgroup|create +time +ping\" \"user nq-inspector on >$$NORA_REDIS_INSPECTOR_PASSWORD ~nq:* +xinfo +xlen +xpending +xrange +xread +get +time +info +ping\" > /run/acl/users.acl && chown redis:redis /run/acl/users.acl && exec docker-entrypoint.sh redis-server --aclfile /run/acl/users.acl --appendonly yes --appendfsync everysec --maxmemory-policy noeviction --no-appendfsync-on-rewrite no --dir /data"
      ],
      "tmpfs": [
        "/run/acl"
      ],
      "volumes": [
        "redis-data:/data"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "signal-bridge": {
      "image": "ghcr.io/mikeng-io/nora-signal-bridge@sha256:a2ab188d499de0971fe9c124c194db23c3eed65e45dd1f351429cf2e0daa6338",
      "container_name": "signal-bridge",
      "restart": "unless-stopped",
      "networks": [
        "nora"
      ],
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "volumes": [
        "${NORA_RUNTIME_ROOT:?}/state/signal-cli:/data/signal-cli",
        "${NORA_RUNTIME_ROOT:?}/state/bridge/signal:/data/bridge",
        "bridge-projection:/bridge-projection:ro"
      ],
      "environment": [
        "XDG_DATA_HOME=/data",
        "SIGNAL_ACCOUNT=${SIGNAL_ACCOUNT:?set SIGNAL_ACCOUNT in .env}",
        "NORA_REDIS_URL=redis://nq-producer:${NORA_REDIS_PRODUCER_PASSWORD:?}@redis:6379/0",
        "NORA_BRIDGE_API_TOKEN=${NORA_BRIDGE_API_TOKEN:-${NORA_BRIDGE_TOKEN:?set NORA_BRIDGE_API_TOKEN in .env}}",
        "NORA_BRIDGE_CORRELATION_KEY=${NORA_BRIDGE_CORRELATION_KEY:?}",
        "NORA_BRIDGE_CORRELATION_KEY_VERSION=${NORA_BRIDGE_CORRELATION_KEY_VERSION:-1}",
        "NORA_BRIDGE_ACCOUNT_KEY=${SIGNAL_BRIDGE_ACCOUNT_KEY:?set SIGNAL_BRIDGE_ACCOUNT_KEY in .env}",
        "NORA_BRIDGE_JOURNAL=/data/bridge/journal/signal.jsonl",
        "DATABASE_URL=postgresql+asyncpg://nora:${POSTGRES_PASSWORD:?}@db:5432/nora",
        "NORA_BRIDGE_ATTACH_DIR=/data/bridge/attachments",
        "NORA_BRIDGE_PORT=18090",
        "NORA_TRACING_ENABLED=${NORA_TRACING_ENABLED:-}",
        "NORA_TRACING_ENDPOINT=${NORA_TRACING_ENDPOINT:-}",
        "NORA_TRACING_EXPORTER=${NORA_TRACING_EXPORTER:-otlp_http}",
        "NORA_TRACING_HEADERS_ENV=${NORA_TRACING_HEADERS_ENV:-}",
        "LANGFUSE_OTLP_HEADERS=${LANGFUSE_OTLP_HEADERS:-}"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "printf 'Authorization: Bearer %s\\n' \"$$NORA_BRIDGE_API_TOKEN\" | curl -fsS -m 5 -H @- http://127.0.0.1:18090/v1/health || exit 1"
        ],
        "interval": "15s",
        "timeout": "10s",
        "retries": 10,
        "start_period": "30s"
      },
      "depends_on": [
        "redis"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "discord-bridge": {
      "image": "ghcr.io/mikeng-io/nora-discord-bridge@sha256:397c7047c443fb193a5a978ad23a9aa97ed508334f0cea6bc3761e723fe6d070",
