{
  "name": "nora-voice-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Receive-only voice sidecar for Nora: @discordjs/voice join -> per-user DAVE-decrypted PCM -> local transport. Dumb pipe; wake/STT live in Python.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spike:mock": "node spike.mjs --mock",
    "spike:live": "node spike.mjs --live",
    "consume": "node consume.mjs"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "0.19.2",
    "discord.js": "^14.23.2"
  },
  "overrides": {
    "@discordjs/node-pre-gyp": {
      "tar": "^7.5.22"
    }
  }
}
