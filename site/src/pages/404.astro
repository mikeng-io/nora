---
// One 404 for both languages: the static host serves it for any unknown
// path, so it says the one line in each and links to both homes.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { art } from "../assets/art";
import { LOCALES } from "../i18n";

const zh = LOCALES["zh-Hant"].dict.notFound;
const en = LOCALES.en.dict.notFound;
---

<Base locale="zh-Hant" title={`${zh.title} · Nora`} index={false}>
  <section class="container lost">
    <Image src={art.lost} alt={zh.imageAlt} widths={[220, 320, 440]} sizes="220px" loading="eager" />
    <div class="copy">
      <h1 class="section-title">{zh.title}</h1>
      <p class="soft">{zh.body}</p>
      <p class="en soft" lang="en">
        <strong>{en.title}</strong> {en.body}
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/" data-lang="zh-Hant">
          {zh.home}
        </a>
        <a class="btn btn-quiet" href="/en/" lang="en" hreflang="en" data-lang="en">
          {en.home}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    gap: 32px;
    justify-items: center;
    text-align: center;
    padding-block: clamp(48px, 10vw, 120px);
  }

  .lost :global(img) {
    width: 220px;
    height: auto;
  }

  .copy {
    display: grid;
    gap: 12px;
    justify-items: center;
  }

  .en strong {
    color: var(--ink);
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 12px;
    margin-top: 16px;
  }
</style>
