---
// One 404 for both languages: the static host serves it for any unknown
// path, so it says the one line in each and links to both homes.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import her from "../../../assets/nora-canonical-self.png";
import { LOCALES } from "../i18n";

const zh = LOCALES["zh-Hant"].dict.notFound;
const en = LOCALES.en.dict.notFound;
---

<Base locale="zh-Hant" title={`${zh.title} · Nora`} index={false}>
  <main id="main" class="lost">
    <Image class="her" src={her} alt={zh.imageAlt} widths={[220, 440]} sizes="220px" loading="eager" />
    <div class="copy">
      <h1 class="display">{zh.title}</h1>
      <p class="lede">{zh.body}</p>
      <p class="lede" lang="en"><strong>{en.title}</strong> {en.body}</p>
      <p class="actions">
        <a class="pill" href="/" data-lang="zh-Hant">{zh.home}</a>
        <a class="pill quiet" href="/en/" lang="en" hreflang="en" data-lang="en">{en.home}</a>
      </p>
    </div>
  </main>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    gap: 32px;
    justify-items: center;
    align-content: center;
    text-align: center;
    padding: 120px var(--stage-pad) 64px;
    background: radial-gradient(ellipse at 50% 30%, #1f283e, var(--canvas) 70%);
  }

  .her {
    width: 220px;
    border-radius: var(--radius-sheet);
  }

  .copy {
    display: grid;
    gap: 14px;
    justify-items: center;
  }

  .display {
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .lede strong {
    color: var(--ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
  }
</style>
