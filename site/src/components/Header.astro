---
import { LOCALES, LOCALE_ORDER, portalLogin, type Locale } from "../i18n";
import NoraMark from "./NoraMark.astro";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale].dict;
const home = LOCALES[locale].path;
const links = [
  { href: "#room", label: t.nav.room },
  { href: "#loop", label: t.nav.loop },
  { href: "#memory", label: t.nav.memory },
  { href: "#form", label: t.nav.form },
];
---

<header class="bar">
  <div class="container inner">
    <a class="brand" href={home} aria-label={t.nav.home}>
      <NoraMark size={36} />
      <span class="wordmark" aria-hidden="true">
        Nora
      </span>
    </a>

    <nav class="links" aria-label={t.nav.menu}>
      {links.map((l) => (
        <a href={home + l.href}>{l.label}</a>
      ))}
    </nav>

    <div class="tools">
      <nav class="lang" aria-label={t.nav.language}>
        {LOCALE_ORDER.map((l) => (
          <a
            href={LOCALES[l].path}
            hreflang={LOCALES[l].lang}
            data-lang={l}
            lang={LOCALES[l].lang}
            aria-current={l === locale ? "true" : undefined}
            aria-label={LOCALES[l].name}
          >
            {LOCALES[l].short}
          </a>
        ))}
      </nav>

      <button
        class="theme"
        type="button"
        data-theme-toggle
        data-label-light={`${t.nav.theme}: ${t.nav.studio}`}
        data-label-dark={`${t.nav.theme}: ${t.nav.night}`}
        aria-label={t.nav.theme}
      >
        <Icon name="sun" class="i-sun" size={18} />
        <Icon name="moon" class="i-moon" size={18} />
      </button>

      <a class="btn btn-outline signin" href={portalLogin(locale)}>
        {t.nav.signIn}
      </a>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--studio) 84%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    border-bottom: 1px solid var(--hairline);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: 9999px;
    padding-right: 4px;
  }

  .wordmark {
    font-family: var(--font-wordmark);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--bun);
  }

  .links {
    display: none;
    gap: 4px;
    margin-left: 24px;
  }

  .links a {
    padding: 8px 12px;
    border-radius: var(--radius-control);
    font-size: 0.9375rem;
    color: var(--ink-soft);
    transition:
      color var(--dur-hover) var(--ease),
      background-color var(--dur-hover) var(--ease);
  }

  .links a:hover {
    color: var(--ink);
    background: var(--hoodie);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .lang {
    display: flex;
    padding: 3px;
    border-radius: 9999px;
    background: var(--hoodie);
  }

  .lang a {
    display: grid;
    place-items: center;
    min-width: 38px;
    height: 32px;
    padding: 0 10px;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-muted);
    transition:
      color var(--dur-hover) var(--ease),
      background-color var(--dur-hover) var(--ease);
  }

  .lang a:hover {
    color: var(--ink);
  }

  .lang a[aria-current] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--hairline);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-control);
    color: var(--ink-soft);
    transition:
      color var(--dur-hover) var(--ease),
      background-color var(--dur-hover) var(--ease);
  }

  .theme:hover {
    color: var(--ink);
    background: var(--hoodie);
  }

  .theme :global(svg) {
    grid-area: 1 / 1;
  }

  /* Show the lighting you would switch TO. */
  .theme :global(.i-sun) {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme :global(.i-sun) {
    display: block;
  }

  :global(:root[data-theme="dark"]) .theme :global(.i-moon) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme :global(.i-sun) {
      display: block;
    }

    :global(:root:not([data-theme="light"])) .theme :global(.i-moon) {
      display: none;
    }
  }

  .signin {
    display: none;
  }

  @media (min-width: 560px) {
    .signin {
      display: inline-flex;
    }
  }

  @media (min-width: 960px) {
    .links {
      display: flex;
    }
  }
</style>
