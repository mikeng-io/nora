---
// The stage's bar: her mark and name, and the language. Thin and
// quiet over the world (DESIGN.md §7, stage navigation); the scene index is
// the rail on the side (Journey.astro).
import { LOCALES, LOCALE_ORDER, type Locale } from "../i18n";
import NoraMark from "./NoraMark.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale].dict;
---

<header class="bar">
  <a class="brand" href={LOCALES[locale].path} aria-label={t.nav.home}>
    <NoraMark size={30} />
    <span class="wordmark" aria-hidden="true">NORA</span>
  </a>
  <div class="tools">
    <nav class="lang" aria-label={t.nav.language}>
      {LOCALE_ORDER.map((l) => (
        <a
          href={LOCALES[l].path}
          hreflang={LOCALES[l].lang}
          lang={LOCALES[l].lang}
          data-lang={l}
          aria-current={l === locale ? "true" : undefined}
          aria-label={LOCALES[l].name}
        >
          {LOCALES[l].short}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // A language picked here is remembered, so the zh-Hant home stops sending
  // an English-first browser to /en/ (layouts/Base.astro).
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-lang]")) {
    a.addEventListener("click", () => {
      try {
        localStorage.setItem("nora-lang", a.dataset.lang ?? "");
      } catch {}
    });
  }
</script>

<style>
  .bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px var(--stage-pad);
    pointer-events: none;
  }

  .bar > * {
    pointer-events: auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .wordmark {
    font: 650 1.5rem/1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--chestnut);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .lang {
    display: flex;
    gap: 4px;
    font-size: 0.8125rem;
  }

  .lang a {
    padding: 6px 8px;
    border-radius: 8px;
    color: var(--ink-soft);
  }

  .lang a[aria-current] {
    color: var(--ink);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .pill {
    height: 38px;
    padding: 0 16px;
  }
</style>
