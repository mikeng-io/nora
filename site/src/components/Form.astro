---
import { Image, getImage } from "astro:assets";
import { art } from "../assets/art";
import { LOCALES, type Locale } from "../i18n";
import Icon from "./Icon.astro";
import LitPatch from "./LitPatch.astro";
import plateStudio from "../assets/rig/plate-studio.webp";
import plateNight from "../assets/rig/plate-night.webp";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale].dict.form;

// The current Bauhinia anchors in design/self-reference/09, pinned on the canonical
// portrait. x/y are fractions of the portrait (1024x1536); `ly` is where the
// label sits when it cannot share the point's height; `side` picks the
// column. The first anchor (proportions) is drawn as a ruler instead.
interface Pin {
  x: number;
  y: number;
  ly?: number;
  side: "l" | "r";
}
const PINS: (Pin | null)[] = [
  null,
  { x: 0.46, y: 0.105, side: "l" },
  { x: 0.53, y: 0.33, ly: 0.29, side: "r" },
  { x: 0.65, y: 0.37, ly: 0.41, side: "r" },
  { x: 0.51, y: 0.48, ly: 0.55, side: "l" },
  { x: 0.30, y: 0.17, ly: 0.28, side: "l" },
  { x: 0.54, y: 0.72, ly: 0.72, side: "r" },
  { x: 0.61, y: 0.91, ly: 0.91, side: "r" },
];

// Portrait sits in the middle half of a 4:3 plate; convert to plate percentages.
const px = (x: number) => 25 + x * 50;
const py = (y: number) => y * 100;
const LABEL_L = 22;
const LABEL_R = 78;

const sheetFull = await getImage({ src: art.sheet, width: 1254, format: "webp", quality: 86 });

// The plate follows the lighting like the hero does: the studio portrait by
// day, its late-night twin (same pose, same framing, so the pins still land)
// in the dark theme. scripts/prefs.ts re-points the sources on a manual choice.
const widths = [480, 720, 1024];
const sizes = "(min-width: 1024px) 580px, 92vw";
const set = async (src: ImageMetadata, format: "avif" | "webp") =>
  (await getImage({ src, widths, sizes, format, quality: 80 })).srcSet.attribute;
const plate = {
  studioAvif: await set(art.canonical, "avif"),
  studioWebp: await set(art.canonical, "webp"),
  nightAvif: await set(art.nightPortrait, "avif"),
  nightWebp: await set(art.nightPortrait, "webp"),
  fallback: (await getImage({ src: art.canonical, width: 720, format: "webp", quality: 80 })).src,
};

// Her studio without her (scripts/make_rig.py), behind her once she is live,
// so the plate can stand empty until she walks onto her mark.
const empty = async (src: ImageMetadata) => (await getImage({ src, width: 1024, format: "webp", quality: 80 })).src;
const plates = `--plate-studio:url(${await empty(plateStudio)});--plate-night:url(${await empty(plateNight)})`;
---

<section id="form" class="section" aria-labelledby="form-title">
  <div class="container">
    <div class="intro">
      <h2 id="form-title" class="section-title">
        {t.title}
      </h2>
      <div class="body">
        {t.body.map((p) => (
          <p class="soft">{p}</p>
        ))}
      </div>
    </div>

    <figure class="plate">
      <figcaption>
        <h3 class="title">{t.anchorsTitle}</h3>
      </figcaption>
      <div class="stage">
        <div
          class="portrait-box"
          style={plates}
          data-nora-slot="form"
          data-nora-figure
          data-kind="stand"
          data-pose="stand"
          data-pose-dark="stand-night"
          data-framed
        >
          <picture data-lit class="nora-static">
            <source
              data-scheme="dark"
              media="(prefers-color-scheme: dark)"
              type="image/avif"
              srcset={plate.nightAvif}
              sizes={sizes}
            />
            <source
              data-scheme="dark"
              media="(prefers-color-scheme: dark)"
              type="image/webp"
              srcset={plate.nightWebp}
              sizes={sizes}
            />
            <source type="image/avif" srcset={plate.studioAvif} sizes={sizes} />
            <source type="image/webp" srcset={plate.studioWebp} sizes={sizes} />
            <LitPatch />
            <img
              class="portrait"
              src={plate.fallback}
              alt={t.figureAlt}
              width={art.canonical.width}
              height={art.canonical.height}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <svg class="lines" viewBox="0 0 100 75" preserveAspectRatio="none" aria-hidden="true">
          <g vector-effect="non-scaling-stroke">
            {/* the ruler: top of the bun to the soles, head height ticked */}
            <line x1="20" y1={0.04 * 75} x2="20" y2={0.95 * 75} />
            <line x1="19" y1={0.04 * 75} x2="21" y2={0.04 * 75} />
            <line x1="19.4" y1={0.405 * 75} x2="20.6" y2={0.405 * 75} />
            <line x1="19.4" y1={0.77 * 75} x2="20.6" y2={0.77 * 75} />
            <line x1="19" y1={0.95 * 75} x2="21" y2={0.95 * 75} />
            {PINS.map((p, i) => {
              if (!p) return null;
              const x = px(p.x);
              const y = (py(p.y) * 75) / 100;
              const ly = (py(p.ly ?? p.y) * 75) / 100;
              const edge = p.side === "l" ? LABEL_L + 1.5 : LABEL_R - 1.5;
              const elbow = p.side === "l" ? Math.min(x - 3, 30) : Math.max(x + 3, 70);
              return <polyline points={`${edge},${ly} ${elbow},${ly} ${x},${y}`} data-anchor={i} />;
            })}
          </g>
        </svg>
        {PINS.map((p) =>
          p ? <span class="pin" style={`left:${px(p.x)}%;top:${py(p.y)}%`} aria-hidden="true" /> : null,
        )}
        <ol class="labels">
          {t.anchors.map((a, i) => {
            const p = PINS[i];
            const style = p
              ? p.side === "l"
                ? `right:${100 - LABEL_L}%;top:${py(p.ly ?? p.y)}%`
                : `left:${LABEL_R}%;top:${py(p.ly ?? p.y)}%`
              : `right:${100 - 18.5}%;top:${py(0.5)}%`;
            return (
              <li class:list={["label-item", p ? `side-${p.side}` : "side-l ruler"]} style={style}>
                <span class="n mono">{i + 1}</span>
                <span>{a}</span>
              </li>
            );
          })}
        </ol>
      </div>
    </figure>

    <blockquote class="quote">
      <p>{t.quote}</p>
    </blockquote>

    <div class="refs">
      <figure class="ref">
        <a class="sheet-link" href={sheetFull.src} data-lightbox aria-label={`${t.enlarge}: ${t.sheetCaption}`}>
          <Image
            src={art.sheet}
            alt={t.sheetAlt}
            widths={[360, 560, 800]}
            sizes="(min-width: 900px) 560px, 92vw"
            loading="lazy"
          />
          <span class="enlarge" aria-hidden="true">
            <Icon name="expand" size={16} />
          </span>
        </a>
        <figcaption class="soft">{t.sheetCaption}</figcaption>
      </figure>
      <figure class="ref">
        <div class="tpose">
          <Image
            src={art.tpose}
            alt={t.tposeAlt}
            widths={[300, 460, 680]}
            sizes="(min-width: 900px) 340px, 92vw"
            loading="lazy"
          />
        </div>
        <figcaption class="soft">{t.tposeCaption}</figcaption>
      </figure>
    </div>
  </div>

  <dialog class="lightbox" aria-label={t.sheetCaption}>
    <form method="dialog">
      <button class="close btn btn-quiet" aria-label={t.close}>
        <Icon name="close" />
      </button>
    </form>
    <img
      src={sheetFull.src}
      alt={t.sheetAlt}
      width={art.sheet.width}
      height={art.sheet.height}
      loading="lazy"
      decoding="async"
    />
  </dialog>
</section>

<script>
  // Progressive: without script the sheet link opens the full image.
  const link = document.querySelector<HTMLAnchorElement>("[data-lightbox]");
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
  if (link && dialog) {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      dialog.showModal();
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .intro {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .body {
    display: grid;
    gap: 16px;
    max-width: 40rem;
    font-size: 1.0625rem;
  }

  /* ------------------------------------------------- the annotated plate */

  .plate {
    display: grid;
    gap: 20px;
    max-width: 940px;
    margin-inline: auto;
  }

  /* The plate continues each portrait's own backdrop past its edges:
     edge-averaged samples of the two images (2026-09-26), not tokens,
     because they have to match a photograph, not a theme. */
  .stage {
    --plate: linear-gradient(#b9b6b9, #bfbdc0 30%, #c3c0c4 60%, #c4c1c5 78%, #cbc7ca 84%, #d5cfd0 90%, #d7d1d3);
    position: relative;
    border-radius: var(--radius-sheet);
    background: var(--plate);
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--hairline);
    color: #2b2220;
  }

  :global(:root[data-theme="dark"]) .stage {
    --plate: linear-gradient(
      #2b201c,
      #342621 15%,
      #2d211d 30%,
      #271d1c 60%,
      #271d1b 78%,
      #422e26 84%,
      #704f3c 90%,
      #543e35
    );
    color: #f2eded;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .stage {
      --plate: linear-gradient(
        #2b201c,
        #342621 15%,
        #2d211d 30%,
        #271d1c 60%,
        #271d1b 78%,
        #422e26 84%,
        #704f3c 90%,
        #543e35
      );
      color: #f2eded;
    }
  }

  .stage :global(.portrait) {
    width: 100%;
    height: auto;
  }

  .portrait-box {
    aspect-ratio: 2 / 3;
  }

  /* Live: the empty studio behind her, for the moments she is not on her mark. */
  .portrait-box[data-state] {
    background: var(--plate-studio) center / cover no-repeat;
  }

  :global(:root[data-theme="dark"]) .portrait-box[data-state] {
    background-image: var(--plate-night);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .portrait-box[data-state] {
      background-image: var(--plate-night);
    }
  }

  .lines,
  .pin {
    display: none;
  }

  /* Below 1024px the anchors are a list under the portrait, on the plate's
     own floor colour; from 1024px they are pinned on it. */
  .labels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px 20px;
    padding: 20px 20px 24px;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .label-item {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .label-item .n {
    opacity: 0.72;
    transition: color var(--dur) var(--ease);
  }

  .label-item.lit .n {
    color: var(--blush);
    opacity: 1;
  }

  .plate figcaption {
    display: grid;
    gap: 12px;
  }

  .plate figcaption :global(.title) {
    font-size: 1.25rem;
    font-weight: 650;
  }

  @media (min-width: 1024px) {
    .stage {
      aspect-ratio: 4 / 3;
    }

    .portrait-box {
      position: absolute;
      left: 25%;
      top: 0;
      width: 50%;
      height: 100%;
      aspect-ratio: auto;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 24%, #000 76%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 24%, #000 76%, transparent);
    }

    .stage :global(.portrait) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .lines {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      fill: none;
      stroke: currentColor;
      stroke-opacity: 0.55;
      stroke-width: 1;
    }

    .lines :global(*) {
      vector-effect: non-scaling-stroke;
    }

    .pin {
      display: block;
      position: absolute;
      z-index: 3;
      width: 9px;
      height: 9px;
      margin: -4.5px 0 0 -4.5px;
      border-radius: 50%;
      background: currentColor;
      box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 22%, transparent);
      transition:
        transform var(--dur) var(--ease),
        background-color var(--dur) var(--ease);
    }

    /* The part of her being pointed at: blush, because it is her. */
    .pin.lit {
      background: var(--blush);
      transform: scale(1.45);
    }

    .lines :global(polyline) {
      transition: stroke-opacity var(--dur) var(--ease);
    }

    .lines :global(polyline.lit) {
      stroke-opacity: 1;
    }

    .labels {
      display: block;
      padding: 0;
    }

    .label-item {
      position: absolute;
      z-index: 3;
      display: flex;
      align-items: baseline;
      gap: 8px;
      transform: translateY(-50%);
      max-width: 20%;
      font-size: 0.875rem;
      font-weight: 500;
      line-height: 1.3;
    }

    .label-item.side-l {
      flex-direction: row-reverse;
      text-align: right;
    }

    .label-item .n {
      opacity: 0.72;
    }

    .plate figcaption {
      justify-items: center;
    }
  }

  /* ---------------------------------------------------------- the quote */

  .quote {
    margin: clamp(56px, 8vw, 104px) auto;
    max-width: 52rem;
    text-align: center;
  }

  .quote p {
    font-size: clamp(1.625rem, 1.1rem + 2vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: balance;
  }

  :lang(zh) .quote p {
    letter-spacing: 0;
    line-height: 1.4;
  }

  .quote p::before,
  .quote p::after {
    color: var(--ink-muted);
  }

  .quote::before {
    content: "";
    display: block;
    width: 1px;
    height: 56px;
    margin: 0 auto 28px;
    background: var(--seam);
  }

  /* ------------------------------------------------------- the references */

  .refs {
    display: grid;
    gap: 40px;
  }

  .ref {
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .ref figcaption {
    font-size: 0.9375rem;
  }

  .sheet-link {
    position: relative;
    display: block;
    border-radius: var(--radius-panel);
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--hairline);
  }

  .sheet-link :global(img) {
    width: 100%;
    transition: transform var(--dur-sheet) var(--ease);
  }

  .sheet-link:hover :global(img) {
    transform: scale(1.015);
  }

  .enlarge {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--hairline);
  }

  .tpose {
    border-radius: var(--radius-panel);
    overflow: hidden;
    background: var(--hoodie);
    box-shadow: 0 0 0 1px var(--hairline);
  }

  .tpose :global(img) {
    width: 100%;
    height: auto;
  }

  @media (min-width: 900px) {
    .refs {
      grid-template-columns: minmax(0, 5fr) minmax(0, 3fr);
      gap: 32px;
      align-items: start;
    }
  }

  /* ---------------------------------------------------------- lightbox */

  .lightbox {
    width: min(94vw, 1100px);
    max-height: 92svh;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sheet);
    background: var(--surface);
    color: var(--ink);
    box-shadow:
      0 0 0 1px var(--hairline),
      var(--shadow-float);
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--studio) 72%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .lightbox[open] {
    animation: sheet-in var(--dur-sheet) var(--ease);
  }

  .lightbox img {
    width: 100%;
    height: auto;
    max-height: 92svh;
    object-fit: contain;
  }

  .lightbox form {
    position: absolute;
    top: 10px;
    right: 10px;
  }

  .close {
    width: 44px;
    padding: 0;
    background: color-mix(in srgb, var(--surface) 86%, transparent);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet-link:hover :global(img) {
      transform: none;
    }

    @keyframes sheet-in {
      from {
        opacity: 0;
      }
    }
  }
</style>
