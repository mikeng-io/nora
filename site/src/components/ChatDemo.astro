---
import { Image } from "astro:assets";
import { art } from "../assets/art";
import { LOCALES, type Locale } from "../i18n";
import type { Person } from "../i18n/types";
import NoraAvatar from "./NoraAvatar.astro";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = LOCALES[locale].dict.chat;

// Invented people, each in a fixed hue at one saturation and lightness, none
// of them near denim, blush or a semantic colour (DESIGN.md, Person-Hue Rule).
const HUE: Record<Person, number> = { ken: 188, mei: 282, jo: 96 };
const PLATFORMS = ["Signal", "WhatsApp", "Discord", "Instagram"] as const;
---

<section id="room" class="section room" aria-labelledby="room-title" data-chat>
  <div class="container grid">
    <div class="intro">
      <div class="section-head">
        <h2 id="room-title" class="section-title">
          {c.title}
        </h2>
        <p class="lede">{c.lede}</p>
      </div>

      <div class="ask" data-chat-controls hidden>
        <p class="label">{c.promptsLabel}</p>
        <ul class="prompts">
          {c.exchanges.map((x) => (
            <li>
              <button
                type="button"
                class:list={["prompt", { skip: Boolean(x.skip) }]}
                data-prompt={x.id}
                data-after={x.own ? "remind" : undefined}
              >
                <span class="glyph" aria-hidden="true">
                  <Icon name={x.skip ? "clock" : "arrow-right"} size={16} class="i-go" />
                  <Icon name="check" size={16} class="i-done" />
                </span>
                <span>{x.prompt}</span>
              </button>
            </li>
          ))}
        </ul>
        <button type="button" class="btn btn-outline replay" data-replay hidden>
          <Icon name="replay" size={16} />
          {c.replay}
        </button>
      </div>

      <p class="disclaimer">{c.disclaimer}</p>
    </div>

    <div class="demo">
      <div class="window-wrap">
        <div class="perch" aria-hidden="true">
          <Image
            src={art.groupChat}
            alt=""
            widths={[140, 280, 420]}
            sizes="(min-width: 1024px) 140px, 104px"
            loading="lazy"
          />
        </div>
        <div class="window" data-skin="signal">
          <div class="window-bar">
            <span class="room-avatar" aria-hidden="true">
              {(Object.keys(HUE) as Person[]).map((p) => (
                <span style={`--h:${HUE[p]}`} />
              ))}
            </span>
            <div class="room-name">
              <p class="title">{c.roomName}</p>
              <p class="mono muted">{c.members}</p>
            </div>
            <p class="on mono" aria-live="polite">
              {PLATFORMS.map((p, i) => (
                <span data-on={p.toLowerCase()} hidden={i !== 0}>
                  {p}
                </span>
              ))}
            </p>
          </div>

          <!-- The live region wraps the list, so the list keeps its own semantics. -->
          <div role="log" aria-label={c.logLabel}>
            <ol class="log" aria-label={c.logLabel} tabindex="0" data-log>
              {c.seed.map((m) => (
                <li class="msg" style={`--h:${HUE[m.who]}`}>
                  <span class="face" aria-hidden="true">
                    {c.people[m.who].slice(0, 1)}
                  </span>
                  <div class="body">
                    <p class="meta">
                      <span class="name">{c.people[m.who]}</span>
                      <time class="mono">{m.time}</time>
                    </p>
                    <p class="text">{m.text}</p>
                  </div>
                </li>
              ))}
              {c.exchanges.map((x) => (
                <>
                  {x.skip ? (
                    <li class="divider" data-step={x.id}>
                      <span class="mono">{x.skip}</span>
                    </li>
                  ) : (
                    <li class="msg mine" data-step={x.id}>
                      <span class="face" aria-hidden="true">
                        {c.you.slice(0, 1)}
                      </span>
                      <div class="body">
                        <p class="meta">
                          <span class="name">{c.you}</span>
                          <time class="mono" data-clock>
                            {x.time}
                          </time>
                        </p>
                        <p class="text">{x.ask}</p>
                      </div>
                    </li>
                  )}
                  <li class="msg nora" data-step={x.id}>
                    <NoraAvatar size={32} class="face" />
                    <div class="body">
                      <p class="meta">
                        <span class="name">Nora</span>
                        <span class="ai">{c.aiBadge}</span>
                        {x.own && <span class="own">{c.onHerOwn}</span>}
                        <time class="mono" data-clock={x.skip ? undefined : ""}>
                          {x.time}
                        </time>
                      </p>
                      <p class="text">{x.reply}</p>
                    </div>
                    <p class="source mono">
                      <span class="visually-hidden">{c.sourceLabel}: </span>
                      {x.source}
                    </p>
                  </li>
                </>
              ))}
              <li class="msg nora typing" data-typing hidden>
                <NoraAvatar size={32} active class="face" />
                <div class="body">
                  <span class="dots" aria-hidden="true">
                    <i></i>
                    <i></i>
                    <i></i>
                  </span>
                  <span class="visually-hidden">{c.typing}</span>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </div>

      <div class="under">
        <div class="skins" role="group" aria-label={c.platformLabel}>
          {PLATFORMS.map((p, i) => (
            <button type="button" data-platform={p.toLowerCase()} aria-pressed={i === 0 ? "true" : "false"}>
              {p}
            </button>
          ))}
        </div>
        <p class="same">
          <span class="presence" aria-hidden="true"></span>
          {c.sameNora}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/chat.ts";
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }

  .intro {
    display: grid;
    align-content: start;
    gap: 28px;
  }

  .intro .section-head {
    margin-bottom: 0;
  }

  .ask {
    display: grid;
    gap: 12px;
    justify-items: start;
  }

  .prompts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .prompt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px 0 12px;
    border-radius: 9999px;
    border: 1px solid var(--seam);
    background: var(--surface);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    text-align: left;
    transition:
      background-color var(--dur-hover) var(--ease),
      border-color var(--dur-hover) var(--ease),
      color var(--dur-hover) var(--ease),
      opacity var(--dur) var(--ease);
  }

  .prompt:hover:not([aria-disabled="true"]) {
    border-color: var(--denim);
    color: var(--denim);
  }

  .prompt .glyph {
    display: grid;
    color: var(--denim);
  }

  .prompt .glyph :global(svg) {
    grid-area: 1 / 1;
  }

  .prompt :global(.i-done) {
    visibility: hidden;
  }

  .prompt.used {
    background: var(--hoodie);
    border-color: var(--hoodie);
    color: var(--ink-muted);
  }

  .prompt.used :global(.i-go) {
    visibility: hidden;
  }

  .prompt.used :global(.i-done) {
    visibility: visible;
    color: var(--success);
  }

  .prompt[aria-disabled="true"] {
    cursor: default;
  }

  .prompt[aria-disabled="true"]:not(.used) {
    opacity: 0.45;
  }

  .replay {
    margin-top: 8px;
  }

  .disclaimer {
    font-size: 0.875rem;
    color: var(--ink-muted);
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
    max-width: 30rem;
  }

  /* ------------------------------------------------------------ the demo */

  .demo {
    --perch: 104px;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    /* room above the window for her: her height (1.585 x width) less the
       14px she overlaps its top edge */
    padding-top: calc(var(--perch) * 1.585 - 14px);
  }

  .window-wrap {
    position: relative;
  }

  /* She sits on the top edge of the chat window, reading it. */
  .perch {
    position: absolute;
    bottom: calc(100% - 14px);
    right: clamp(72px, 12%, 112px);
    width: var(--perch);
    z-index: 2;
    pointer-events: none;
  }

  .perch :global(img) {
    width: 100%;
    height: auto;
  }

  .under {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  /* Scrolls sideways rather than widening the page on the narrowest phones. */
  .skins {
    display: flex;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    gap: 2px;
    padding: 3px;
    width: fit-content;
    border-radius: 9999px;
    background: var(--hoodie);
  }

  .skins button {
    flex: none;
    height: 34px;
    padding: 0 12px;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-muted);
    transition:
      background-color var(--dur-hover) var(--ease),
      color var(--dur-hover) var(--ease);
  }

  .skins button:hover {
    color: var(--ink);
  }

  .skins button[aria-pressed="true"] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--hairline);
  }

  .window {
    position: relative;
    border-radius: var(--radius-sheet);
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--hairline),
      var(--shadow-float);
    overflow: hidden;
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--hairline);
  }

  .room-avatar {
    position: relative;
    width: 36px;
    height: 36px;
    flex: none;
  }

  .room-avatar span {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: hsl(var(--h) 32% 52%);
    box-shadow: 0 0 0 2px var(--surface);
  }

  .room-avatar span:nth-child(1) {
    left: 0;
    top: 2px;
  }

  .room-avatar span:nth-child(2) {
    right: 0;
    top: 6px;
  }

  .room-avatar span:nth-child(3) {
    left: 8px;
    bottom: 0;
  }

  .room-name {
    display: grid;
    min-width: 0;
  }

  .room-name > * {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .room-name .mono {
    font-size: 0.75rem;
  }

  .on {
    margin-left: auto;
    color: var(--ink-muted);
  }

  .log {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: clamp(400px, 56svh, 500px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 20px 18px 24px;
    scrollbar-width: thin;
    scrollbar-color: var(--seam) transparent;
    transition: opacity var(--dur) var(--ease);
  }

  .log > :first-child {
    margin-top: auto;
  }

  .log.switching {
    opacity: 0;
    transition-duration: var(--dur-hover);
  }

  /* ------------------------------------------------ one DOM, four skins */

  .msg {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    column-gap: 10px;
    align-items: end;
    --person: hsl(var(--h, 30) 32% 46%);
  }

  .face {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--person);
    color: var(--surface);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .mine .face {
    background: var(--ink-soft);
  }

  .body {
    justify-self: start;
    max-width: min(82%, 34rem);
    padding: 8px 14px 9px;
    border-radius: var(--radius-panel);
    background: var(--hoodie);
  }

  .meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 8px;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .name {
    font-weight: 600;
    color: var(--ink-soft);
  }

  .meta time {
    font-size: 0.6875rem;
    color: var(--ink-muted);
  }

  .text {
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .ai,
  .own {
    padding: 0 7px;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.6;
  }

  .ai {
    background: var(--surface);
    color: var(--ink-soft);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--blush) 40%, transparent);
  }

  .own {
    background: var(--surface);
    color: var(--ink-soft);
    box-shadow: 0 0 0 1px var(--hairline);
  }

  /* Her words sit on blush wash (DESIGN.md §7). */
  .nora .body {
    background: var(--blush-wash);
  }

  .nora .name {
    color: var(--ink);
  }

  .mine {
    grid-template-columns: minmax(0, 1fr);
  }

  .mine .face {
    display: none;
  }

  .mine .body {
    justify-self: end;
    background: var(--ink);
    color: var(--studio);
  }

  .mine .name,
  .mine .meta time {
    color: color-mix(in srgb, var(--studio) 72%, transparent);
  }

  /* How she knew: hangs off her bubble on a thin cable. */
  .source {
    grid-column: 2;
    position: relative;
    margin-top: 6px;
    padding-left: 18px;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink-muted);
    max-width: 34rem;
  }

  .source::before {
    content: "";
    position: absolute;
    left: 6px;
    top: -6px;
    width: 8px;
    height: 13px;
    border-left: 1px solid var(--seam);
    border-bottom: 1px solid var(--seam);
    border-bottom-left-radius: 6px;
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-block: 10px;
    color: var(--ink-muted);
  }

  .divider::before,
  .divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  .divider .mono {
    font-size: 0.75rem;
  }

  /* WhatsApp: no faces in the thread, tighter corners, a tail on each bubble. */
  [data-skin="whatsapp"] .msg {
    grid-template-columns: minmax(0, 1fr);
  }

  [data-skin="whatsapp"] .msg > .face,
  [data-skin="whatsapp"] .msg > :global(.face) {
    display: none;
  }

  [data-skin="whatsapp"] .source {
    grid-column: 1;
  }

  [data-skin="whatsapp"] .body {
    border-radius: 4px 12px 12px 12px;
  }

  [data-skin="whatsapp"] .mine .body {
    border-radius: 12px 4px 12px 12px;
  }

  [data-skin="whatsapp"] .meta time {
    order: 9;
    margin-left: auto;
  }

  /* Discord: no bubbles, rows with a name line; her rows carry the wash. */
  [data-skin="discord"] .log {
    gap: 4px;
    padding-inline: 0;
  }

  [data-skin="discord"] .msg,
  [data-skin="discord"] .mine {
    grid-template-columns: 36px minmax(0, 1fr);
    column-gap: 14px;
    align-items: start;
    padding: 6px 18px;
  }

  [data-skin="discord"] .face,
  [data-skin="discord"] .msg > :global(.face) {
    width: 36px;
    height: 36px;
  }

  [data-skin="discord"] .mine .face {
    display: grid;
  }

  [data-skin="discord"] .body,
  [data-skin="discord"] .mine .body {
    justify-self: stretch;
    max-width: none;
    padding: 0;
    border-radius: 0;
    background: none;
    color: var(--ink);
  }

  [data-skin="discord"] .mine .name {
    color: var(--ink-soft);
  }

  [data-skin="discord"] .mine .meta time {
    color: var(--ink-muted);
  }

  [data-skin="discord"] .name {
    font-size: 0.875rem;
  }

  [data-skin="discord"] .nora {
    background: var(--blush-wash);
    box-shadow: inset 2px 0 0 var(--blush);
  }

  [data-skin="discord"] .nora .body {
    background: none;
  }

  [data-skin="discord"] .source {
    padding-bottom: 2px;
  }

  [data-skin="discord"] .divider {
    padding-inline: 18px;
  }

  /* Instagram: round pills, faces small, times out of the way. */
  [data-skin="instagram"] .msg {
    grid-template-columns: 26px minmax(0, 1fr);
  }

  [data-skin="instagram"] .face,
  [data-skin="instagram"] .msg > :global(.face) {
    width: 26px;
    height: 26px;
    font-size: 0.6875rem;
  }

  [data-skin="instagram"] .mine {
    grid-template-columns: minmax(0, 1fr);
  }

  [data-skin="instagram"] .body {
    border-radius: 22px;
    padding: 9px 16px 10px;
  }

  [data-skin="instagram"] .meta time {
    display: none;
  }

  /* ------------------------------------------------- live and entering */

  .dots {
    display: inline-flex;
    gap: 5px;
    padding: 6px 2px;
  }

  .dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blush);
    animation: think 1.2s var(--ease) infinite;
  }

  .dots i:nth-child(2) {
    animation-delay: 0.16s;
  }

  .dots i:nth-child(3) {
    animation-delay: 0.32s;
  }

  /* Her thinking indicator is live state: it may loop, and only while she thinks. */
  @keyframes think {
    0%,
    100% {
      opacity: 0.3;
    }
    40% {
      opacity: 1;
    }
  }

  :global(.enter) {
    animation: enter var(--dur-sheet) var(--ease) both;
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    @keyframes enter {
      from {
        opacity: 0;
      }
    }
  }

  .same {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  @media (min-width: 640px) {
    .demo {
      --perch: 128px;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 64px;
      align-items: start;
    }

    .intro {
      position: sticky;
      top: 112px;
    }

    .demo {
      --perch: 140px;
    }
  }
</style>
