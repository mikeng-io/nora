---
import { getImage } from "astro:assets";
import { art } from "../assets/art";
import { LOCALES, portalLogin, type Locale } from "../i18n";
import Icon from "./Icon.astro";
import LitPatch from "./LitPatch.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale].dict;

// Art direction by lighting: the studio portrait by day, its late-night twin
// in the dark theme. Written as a hand-made <picture> because the choice is
// a media query (the system scheme), which the theme script re-points when
// someone picks a lighting by hand (scripts/prefs.ts).
const widths = [360, 520, 720, 960];
const sizes = "(min-width: 1024px) 440px, (min-width: 640px) 60vw, 92vw";
const variants = async (src: ImageMetadata) => {
  const [avif, webp] = await Promise.all(
    (["avif", "webp"] as const).map((format) => getImage({ src, widths, sizes, format, quality: 78 })),
  );
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src };
};
const studio = await variants(art.canonical);
const night = await variants(art.nightPortrait);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <p class="status">
        <span class="presence" aria-hidden="true"></span>
        {t.hero.status}
      </p>
      <h1 id="hero-title" class="display">
        {t.hero.title}
      </h1>
      <p class="lede">{t.hero.lede}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#room">
          {t.hero.primary}
          <Icon name="arrow-down" />
        </a>
        <a class="btn btn-quiet" href={portalLogin(locale)}>
          {t.hero.secondary}
          <Icon name="arrow-right" />
        </a>
      </div>
      <p class="platforms mono">{t.hero.platforms}</p>
    </div>

    <figure class="stage">
      <div class="frame">
        <picture data-lit>
          <source
            data-scheme="dark"
            media="(prefers-color-scheme: dark)"
            type="image/avif"
            srcset={night.avif}
            sizes={sizes}
          />
          <source
            data-scheme="dark"
            media="(prefers-color-scheme: dark)"
            type="image/webp"
            srcset={night.webp}
            sizes={sizes}
          />
          <source type="image/avif" srcset={studio.avif} sizes={sizes} />
          <source type="image/webp" srcset={studio.webp} sizes={sizes} />
          <LitPatch />
          <img
            src={studio.src}
            alt={t.hero.alt}
            data-alt-light={t.hero.alt}
            data-alt-dark={t.hero.nightAlt}
            width={art.canonical.width}
            height={art.canonical.height}
            fetchpriority="high"
            decoding="async"
          />
        </picture>

        <div class="lights" role="group" aria-label={t.hero.lights}>
          <button type="button" data-theme-set="light" aria-pressed="false">
            <Icon name="sun" size={16} />
            <span>{t.nav.studio}</span>
          </button>
          <button type="button" data-theme-set="dark" aria-pressed="false">
            <Icon name="moon" size={16} />
            <span>{t.nav.night}</span>
          </button>
        </div>
      </div>
      <figcaption class="mono">{t.hero.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(32px, 6vw, 88px) clamp(72px, 9vw, 128px);
  }

  .grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  .copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border-radius: 9999px;
    border: 1px solid var(--hairline);
    background: var(--surface);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .display {
    max-width: 11.5em;
  }

  :lang(zh) .display {
    max-width: 9em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-top: 8px;
  }

  .platforms {
    color: var(--ink-muted);
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
    width: 100%;
    max-width: 30rem;
  }

  .stage {
    display: grid;
    gap: 14px;
    justify-self: center;
    width: min(100%, 440px);
  }

  .frame {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-sheet);
    overflow: hidden;
    background: var(--hoodie);
    box-shadow: 0 0 0 1px var(--hairline);
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lights {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    padding: 3px;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--seam) 55%, transparent);
  }

  .lights button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-soft);
    transition:
      background-color var(--dur-hover) var(--ease),
      color var(--dur-hover) var(--ease);
  }

  .lights button:hover {
    color: var(--ink);
  }

  .lights button[aria-pressed="true"] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--hairline);
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink-muted);
  }

  /* The cable: one thin line, leading into her caption. */
  figcaption::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--seam);
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) 440px;
      gap: 72px;
      min-height: calc(100svh - 64px - 120px);
    }

    .stage {
      justify-self: end;
    }
  }
</style>
