---
import { LOCALES, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale].dict.loop;
---

<section id="loop" class="section" aria-labelledby="loop-title">
  <div class="container">
    <div class="section-head">
      <h2 id="loop-title" class="section-title">
        {t.title}
      </h2>
      <p class="lede">{t.lede}</p>
    </div>

    <div class="paths">
      <article class="path">
        <h3 class="path-title">{t.tagTitle}</h3>
        <p class="soft">{t.tagBody}</p>
        <!-- A straight cable: in, through, out. The last stop is her speaking, so it is blush. -->
        <ol class="cable straight">
          {t.tagSteps.map((s, i) => (
            <li class:list={{ her: i === t.tagSteps.length - 1 }}>
              <span class="n mono">{String(i + 1).padStart(2, "0")}</span>
              <span class="step">{s}</span>
            </li>
          ))}
        </ol>
      </article>

      <article class="path">
        <h3 class="path-title">{t.ambientTitle}</h3>
        <p class="soft">{t.ambientBody}</p>
        <!-- The same cable, closed into a loop through the people: the line on
             the left carries it from the last stop back to the first. -->
        <ol class="cable loop">
          {t.stages.map((s, i) => (
            <li class:list={{ her: i === t.stages.length - 1 }}>
              <span class="n mono">{String(i + 1).padStart(2, "0")}</span>
              <span class="step">{s.title}</span>
              <span class="desc">{s.body}</span>
            </li>
          ))}
          <li class="people">
            <span class="n mono">{String(t.stages.length + 1).padStart(2, "0")}</span>
            <span class="step">{t.people.title}</span>
            <span class="desc">{t.people.body}</span>
          </li>
        </ol>
        <p class="closing">{t.closing}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .paths {
    display: grid;
    gap: 64px;
  }

  .path {
    display: grid;
    align-content: start;
    gap: 16px;
  }

  .path-title {
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .path > .soft {
    max-width: 34rem;
  }

  /* The Cable Rule: one 1px line; stops sit on it. Each stop draws the
     segment down to the next one, so the line starts and ends exactly on a
     dot at any text length. `--c` is the dot's centre from the stop's top. */
  .cable {
    display: grid;
    margin-top: 16px;
  }

  .cable li {
    --pad: 12px;
    --c: calc(var(--pad) + 14px);
    position: relative;
    display: grid;
    grid-template-columns: 15px 32px minmax(0, 1fr);
    column-gap: 16px;
    align-items: baseline;
    padding-block: var(--pad);
  }

  .cable li::before {
    content: "";
    position: relative;
    z-index: 1;
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--studio);
    box-shadow: inset 0 0 0 1px var(--seam);
  }

  .cable li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 7px;
    top: var(--c);
    height: 100%;
    width: 1px;
    background: var(--seam);
  }

  .cable li.her::before {
    background: var(--blush);
    box-shadow: 0 0 0 4px var(--studio);
  }

  .n {
    grid-column: 2;
    grid-row: 1;
    color: var(--ink-muted);
  }

  .step {
    grid-column: 3;
    grid-row: 1;
    font-weight: 600;
    line-height: 28px;
  }

  .desc {
    grid-column: 3;
    grid-row: 2;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin-top: 2px;
  }

  /* The loop: the same cable, closed on the left. From the last stop it
     runs out, up past every stop, and back into the first. */
  .loop {
    margin-left: 26px;
  }

  .loop li {
    --pad: 14px;
  }

  .loop li .n::before {
    content: "";
    position: absolute;
    left: -26px;
    width: 33px;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--seam);
    pointer-events: none;
  }

  .loop li:first-child .n::before {
    top: var(--c);
    border-top: 1px solid var(--seam);
    border-top-left-radius: 14px;
  }

  .loop li:last-child .n::before {
    bottom: auto;
    height: var(--c);
    border-bottom: 1px solid var(--seam);
    border-bottom-left-radius: 14px;
  }

  /* Where the loop closes: the people, so not blush and not her. */
  .cable li.people::before {
    background: var(--ink-soft);
    box-shadow: 0 0 0 4px var(--studio);
  }

  .closing {
    margin-top: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
    color: var(--ink-soft);
    max-width: 34rem;
  }

  @media (min-width: 900px) {
    .paths {
      grid-template-columns: 1fr 1fr;
      gap: 72px;
    }
  }
</style>
