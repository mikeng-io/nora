---
// Nora's live presence (src/scripts/nora/): the textures her renderer draws
// and the words the page uses for what she is doing, handed to the script
// as one JSON block. Placed once per page that has her in it. Nothing here
// renders: without script, or with reduced motion, every place she can be
// keeps its static render (DESIGN.md §6, presence).
import { getImage } from "astro:assets";
import { LOCALES, type Locale } from "../i18n";
import stand from "../assets/rig/stand.webp";
import standNight from "../assets/rig/stand-night.webp";
import perch from "../assets/rig/perch.webp";
import ledge from "../assets/rig/ledge.webp";
import quiet from "../assets/rig/quiet.webp";
import wave from "../assets/rig/wave.webp";
import lost from "../assets/rig/lost.webp";
import hop from "../assets/rig/hop.webp";
import rigs from "../assets/rig/rig.json";

interface Props {
  locale: Locale;
}

// rig.json is written by scripts/make_rig.py and read by the renderer with
// no checking of its own; a pose that lost its eyes or its anatomy in a
// regeneration fails the build here, not in a visitor's browser.
const need = ["size", "crop", "eyes", "mouth", "head", "neck", "face", "bun", "hips", "ground", "limbs"];
for (const [pose, rig] of Object.entries(rigs as Record<string, Record<string, unknown>>)) {
  const missing = need.filter((k) => !(k in rig));
  const eyes = (rig.eyes as unknown[] | undefined)?.length ?? 0;
  if (missing.length || eyes !== 2) {
    throw new Error(
      `rig.json: pose "${pose}" is incomplete (missing ${missing.join(", ") || "nothing"}, ${eyes} eyes)`,
    );
  }
}

const { locale } = Astro.props;
const t = LOCALES[locale].dict;

// Each at about twice the largest size it is drawn at (the hop's is the
// hero's, since she can leave from there).
const tex = async (src: ImageMetadata, width: number) =>
  (await getImage({ src, width: Math.min(width, src.width), format: "webp", quality: 84 })).src;
const urls = {
  stand: await tex(stand, 780),
  "stand-night": await tex(standNight, 780),
  perch: await tex(perch, 400),
  ledge: await tex(ledge, 560),
  quiet: await tex(quiet, 640),
  wave: await tex(wave, 640),
  lost: await tex(lost, 480),
  hop: await tex(hop, 640),
};
const data = JSON.stringify({ urls, presence: t.presence }).replace(/</g, "\\u003c");
---

<script type="application/json" id="nora-rig" set:html={data} />
<script>
  import "../scripts/nora/index.ts";
</script>
