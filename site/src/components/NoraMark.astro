---
// The emblem: her five-petal Bauhinia clasp with a thread tied off (DESIGN.md
// §2: the project's mark, never a stand-in for her face). One source file,
// src/assets/emblem.svg, in paper colours; on the stage it is recoloured for
// night. The favicon and app icons are rendered from the same file
// (scripts/make_images.py).
import emblem from "../assets/emblem.svg?raw";

interface Props {
  size?: number;
  tone?: "paper" | "night";
}

const { size = 36, tone = "night" } = Astro.props;
const NIGHT: Record<string, string> = { "#bb6954": "#eda28d", "#7a3a1d": "#7a3a1d", "#af5321": "#f8b284", "#f4f1ea": "#0d0e10" };
const svg = (tone === "night" ? emblem.replace(/#[0-9a-f]{6}/g, (c) => NIGHT[c] ?? c) : emblem)
  .replace('role="img" aria-label="Nora"', 'aria-hidden="true" focusable="false"')
  .replace("<svg ", `<svg width="${size}" height="${size}" class="mark" `);
---

<Fragment set:html={svg} />

<style>
  :global(.mark) {
    flex: none;
  }
</style>
