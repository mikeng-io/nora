---
// Her cut-out icon, bare: transparent, no disc, no ring (DESIGN.md §2, §7).
// Beside the wordmark; the favicon and app icons are the same image
// (scripts/make_images.py).
import { Image } from "astro:assets";
import icon from "../../../assets/nora-mini-icon.png";

interface Props {
  size?: number;
}

const { size = 36 } = Astro.props;
---

<Image class="mark" src={icon} alt="" width={size} densities={[1, 2, 3]} loading="eager" decoding="async" style={`--s:${size}px`} />

<style>
  .mark {
    width: var(--s);
    height: auto;
    flex: none;
  }
</style>
