---
// Her cut-out icon, bare: transparent, no disc, no ring. Used beside the
// wordmark (header, footer); the favicon and app icons are the same image
// (scripts/make_images.py). DESIGN.md §2, operator 2026-09-26.
import { Image } from "astro:assets";
import { art } from "../assets/art";

interface Props {
  size?: number;
}

const { size = 36 } = Astro.props;
---

<Image
  class="mark"
  src={art.icon}
  alt=""
  width={size}
  densities={[1, 2, 3]}
  loading="eager"
  decoding="async"
  style={`--s:${size}px`}
/>

<style>
  .mark {
    width: var(--s);
    height: auto;
    flex: none;
  }
</style>
