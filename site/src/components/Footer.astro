---
import { LOCALES, LOCALE_ORDER, portalLogin, type Locale } from "../i18n";
import Icon from "./Icon.astro";
import NoraMark from "./NoraMark.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale].dict;
---

<footer class="foot">
  <div class="container">
    <div class="meta">
      <a class="brand" href={LOCALES[locale].path} aria-label={t.nav.home}>
        <NoraMark size={44} />
        <span class="wordmark" aria-hidden="true">
          Nora
        </span>
      </a>
      <p class="made">
        {t.footer.made}
        <a href="https://mikeng.io" rel="author">
          {t.footer.site}
        </a>
      </p>
      <nav class="links">
        {LOCALE_ORDER.map((l) => (
          <a
            href={LOCALES[l].path}
            hreflang={LOCALES[l].lang}
            data-lang={l}
            lang={LOCALES[l].lang}
            aria-current={l === locale ? "true" : undefined}
          >
            {LOCALES[l].name}
          </a>
        ))}
        <a href="/wiki/">{t.nav.wiki}</a>
        <a href={portalLogin(locale)}>{t.nav.signIn}</a>
        <a href="#main" class="top">
          {t.footer.top}
          <Icon name="arrow-up" size={16} />
        </a>
      </nav>
      <p class="colophon mono">{t.footer.colophon}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--hairline);
    padding-block: clamp(40px, 6vw, 64px) 40px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    border-radius: 9999px;
    padding-right: 4px;
  }

  .wordmark {
    font-family: var(--font-wordmark);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--bun);
  }

  .meta {
    display: grid;
    gap: 20px;
  }

  .made a,
  .links a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--seam);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-hover) var(--ease);
  }

  .made a:hover,
  .links a:hover {
    text-decoration-color: var(--denim);
  }

  .made {
    color: var(--ink-soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 0.9375rem;
  }

  .links a[aria-current] {
    text-decoration: none;
    color: var(--ink-muted);
  }

  .top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .colophon {
    color: var(--ink-muted);
    max-width: 48rem;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  @media (min-width: 900px) {
    .meta {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 24px;
    }

    .colophon {
      grid-column: 1 / -1;
    }
  }
</style>
