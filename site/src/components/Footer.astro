---
import { LOCALES, LOCALE_ORDER, type Locale } from "../i18n";
import NoraMark from "./NoraMark.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale].dict;
---

<footer class="foot">
  <a class="brand" href={LOCALES[locale].path} aria-label={t.nav.home}>
    <NoraMark size={40} />
    <span class="wordmark" aria-hidden="true">NORA</span>
  </a>
  <p class="made">
    {t.footer.made} <a href="https://mikeng.io" rel="author">{t.footer.site}</a>
  </p>
  <nav class="links" aria-label={t.nav.language}>
    {LOCALE_ORDER.map((l) => (
      <a href={LOCALES[l].path} hreflang={LOCALES[l].lang} lang={LOCALES[l].lang} data-lang={l} aria-current={l === locale ? "true" : undefined}>
        {LOCALES[l].name}
      </a>
    ))}
    <a href="https://github.com/mikeng-io/nora" rel="noopener">GitHub</a>
    <a href="#main">{t.footer.top}</a>
  </nav>
  <p class="colophon">{t.footer.colophon}</p>
</footer>

<style>
  .foot {
    position: relative;
    z-index: 6;
    display: grid;
    gap: 16px;
    padding: clamp(48px, 8vw, 96px) var(--stage-pad) 40px;
    background: var(--canvas);
    border-top: 1px solid var(--hairline);
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .wordmark {
    font: 650 1.75rem/1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--chestnut);
  }

  .made a,
  .links a {
    color: var(--ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .links a[aria-current] {
    color: var(--accent-text);
  }

  .colophon {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    opacity: 0.8;
  }
</style>
