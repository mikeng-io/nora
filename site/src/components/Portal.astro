---
import { Image } from "astro:assets";
import { art } from "../assets/art";
import { LOCALES, portalLogin, type Locale } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale].dict.portal;
---

<section id="portal" class="section portal" aria-labelledby="portal-title">
  <div class="container">
    <div class="sheet">
      <div class="copy">
        <h2 id="portal-title" class="section-title">
          {t.title}
        </h2>
        <p class="soft body">{t.body}</p>
        <ul class="items">
          {t.items.map((i) => (
            <li class="badge">{i}</li>
          ))}
        </ul>
        <a class="btn btn-primary" href={portalLogin(locale)}>
          {t.cta}
          <Icon name="arrow-right" />
        </a>
      </div>
      <Image
        class="art"
        src={art.wave}
        alt={t.imageAlt}
        widths={[200, 300, 440, 600]}
        sizes="(min-width: 900px) 300px, 200px"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .portal {
    border-top: 0;
    padding-top: clamp(40px, 6vw, 72px);
  }

  .sheet {
    position: relative;
    display: grid;
    gap: 24px;
    padding: clamp(28px, 5vw, 64px);
    padding-bottom: 0;
    border-radius: var(--radius-sheet);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--hairline);
    overflow: hidden;
  }

  .copy {
    display: grid;
    gap: 20px;
    justify-items: start;
    align-content: start;
    padding-bottom: 8px;
  }

  .body {
    max-width: 34rem;
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .copy .btn {
    margin-top: 8px;
  }

  /* She stands on the bottom edge of the panel. */
  .sheet :global(.art) {
    width: 200px;
    height: auto;
    justify-self: end;
    margin-bottom: -6px;
  }

  @media (min-width: 900px) {
    .sheet {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
      align-items: end;
    }

    .copy {
      align-self: center;
      padding-bottom: clamp(28px, 5vw, 64px);
    }

    .sheet :global(.art) {
      width: 300px;
      margin-right: 24px;
    }
  }
</style>
