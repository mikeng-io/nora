---
import { LOCALES, type Locale } from "../i18n";
import Icon from "./Icon.astro";
import NoraAvatar from "./NoraAvatar.astro";
import clipEn from "../assets/voice/nora-en.mp3?url";
import clipZh from "../assets/voice/nora-zh-hant.mp3?url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale].dict.senses;
// Her voice: a clip made with her own voice settings (MiniMax, the voice and
// speed config.toml gives her voice channel); provenance in src/assets/voice/README.md.
const clip = locale === "zh-Hant" ? clipZh : clipEn;
---

<section id="senses" class="section" aria-labelledby="senses-title">
  <div class="container grid">
    <div class="section-head">
      <h2 id="senses-title" class="section-title">
        {t.title}
      </h2>
      <p class="lede">{t.lede}</p>
    </div>

    <div>
      <dl class="rows">
        {t.rows.map((r) => (
          <div class="row">
            <dt>
              <Icon name={r.icon} size={20} />
              <span>{r.title}</span>
            </dt>
            <dd>
              {r.body}
              {r.icon === "voice" && (
                <div class="voice" data-voice data-voice-src={clip} hidden>
                  <button type="button" class="voice-btn" data-voice-play aria-pressed="false">
                    <NoraAvatar size={28} class="who" />
                    <span class="glyph" aria-hidden="true">
                      <Icon name="play" size={14} class="i-play" />
                      <span class="bars">
                        <i />
                        <i />
                        <i />
                      </span>
                    </span>
                    <span>{t.voice.play}</span>
                  </button>
                  <p class="transcript mono">
                    <span class="visually-hidden">{t.voice.about} </span>“{t.voice.transcript}”
                  </p>
                </div>
              )}
            </dd>
          </div>
        ))}
      </dl>
      <p class="note">{t.note}</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 8px;
  }

  .rows {
    border-top: 1px solid var(--hairline);
  }

  .row {
    display: grid;
    gap: 4px;
    padding-block: 18px;
    border-bottom: 1px solid var(--hairline);
  }

  dt {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
  }

  dt :global(svg) {
    color: var(--ink-muted);
  }

  dd {
    color: var(--ink-soft);
    padding-left: 32px;
  }

  /* Her voice: her avatar lights while she speaks (DESIGN.md §7, the
     speaking indicator is live state), and the words are always written. */
  .voice {
    display: grid;
    gap: 8px;
    justify-items: start;
    margin-top: 12px;
  }

  .voice-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 16px 0 8px;
    border-radius: 9999px;
    border: 1px solid var(--seam);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      border-color var(--dur-hover) var(--ease),
      color var(--dur-hover) var(--ease);
  }

  .voice-btn:hover {
    border-color: var(--denim);
  }

  .voice-btn :global(.who) {
    transition: box-shadow var(--dur) var(--ease);
  }

  .voice:global(.playing) .voice-btn :global(.who) {
    box-shadow: 0 0 0 2px var(--blush);
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 16px;
    color: var(--denim);
  }

  .glyph > :global(*) {
    grid-area: 1 / 1;
  }

  .bars {
    display: none;
    align-items: center;
    gap: 2px;
    height: 14px;
  }

  .bars i {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: var(--blush);
    transform-origin: center;
    animation: speak 0.9s var(--ease) infinite;
  }

  .bars i:nth-child(2) {
    animation-delay: 0.15s;
  }

  .bars i:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes speak {
    0%,
    100% {
      transform: scaleY(0.35);
    }
    50% {
      transform: scaleY(1);
    }
  }

  .voice:global(.playing) .bars {
    display: inline-flex;
  }

  .voice:global(.playing) .glyph :global(.i-play) {
    visibility: hidden;
  }

  .transcript {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .note {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 24px;
    color: var(--ink-soft);
  }

  @media (min-width: 720px) {
    .row {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 24px;
      align-items: baseline;
    }

    dd {
      padding-left: 0;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 64px;
      align-items: start;
    }

    .section-head {
      position: sticky;
      top: 112px;
    }
  }
</style>
