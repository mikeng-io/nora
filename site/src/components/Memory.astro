---
import { Image } from "astro:assets";
import { art } from "../assets/art";
import { LOCALES, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = LOCALES[locale].dict.memory;
---

<section id="memory" class="section" aria-labelledby="memory-title">
  <div class="container">
    <div class="head">
      <div class="section-head">
        <h2 id="memory-title" class="section-title">
          {t.title}
        </h2>
        <p class="lede">{t.lede}</p>
      </div>
      <Image
        class="art"
        src={art.notebook}
        alt={t.imageAlt}
        widths={[180, 260, 360, 520]}
        sizes="(min-width: 900px) 260px, 180px"
        loading="lazy"
      />
    </div>

    <!-- A timescale drawn as one cable: fastest on the left, slowest on the right. -->
    <ol class="scale">
      {t.tiers.map((tier) => (
        <li>
          <span class="when mono">{tier.scale}</span>
          <h3 class="title">{tier.title}</h3>
          <p class="soft">{tier.body}</p>
        </li>
      ))}
    </ol>

    <p class="note">{t.note}</p>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: 24px;
    align-items: end;
  }

  .head .section-head {
    margin-bottom: 0;
  }

  .head :global(.art) {
    width: 180px;
    height: auto;
    justify-self: end;
    margin-right: 8px;
  }

  .scale {
    position: relative;
    display: grid;
    margin-top: 40px;
  }

  .scale::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: var(--seam);
  }

  .scale li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 0 0 36px 40px;
  }

  .scale li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 3px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--studio);
    box-shadow: inset 0 0 0 1px var(--seam);
  }

  .when {
    color: var(--ink-muted);
  }

  .scale .soft {
    font-size: 0.9375rem;
    max-width: 28rem;
  }

  .note {
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
    color: var(--ink-soft);
    max-width: 40rem;
  }

  @media (min-width: 900px) {
    .head {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
    }

    .head :global(.art) {
      width: 260px;
      margin: 0 24px -8px 0;
    }

    .scale {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: 28px;
      margin-top: 56px;
      padding-bottom: 56px;
    }

    .scale::before {
      left: 0;
      right: 0;
      top: 7px;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .scale li {
      padding: 36px 0 0;
    }

    .scale li::before {
      top: 0;
    }
  }
</style>
