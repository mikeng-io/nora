---
// Placed inside a <picture data-lit>, after its sources and before its <img>:
// runs while the page is still parsing, so a lighting chosen by hand (stored,
// and set on <html> by the head script) picks the right portrait before the
// browser has fetched either. Without it the system's pick loads first and
// scripts/prefs.ts swaps it later: a flash and a second download.
---

<script is:inline>
  (function (s) {
    var t = document.documentElement.dataset.theme;
    if (!t) return;
    var d = s.parentNode.querySelectorAll('source[data-scheme="dark"]');
    for (var i = 0; i < d.length; i++) d[i].media = t === "dark" ? "all" : "not all";
  })(document.currentScript);
</script>
