---
import type { Locale } from "../i18n";
import Hero from "./Hero.astro";
import ChatDemo from "./ChatDemo.astro";
import Loop from "./Loop.astro";
import Memory from "./Memory.astro";
import Senses from "./Senses.astro";
import Manners from "./Manners.astro";
import Form from "./Form.astro";
import Portal from "./Portal.astro";
import NoraRig from "./NoraRig.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Hero locale={locale} />
<ChatDemo locale={locale} />
<Loop locale={locale} />
<Memory locale={locale} />
<Senses locale={locale} />
<Manners locale={locale} />
<Form locale={locale} />
<Portal locale={locale} />
<NoraRig locale={locale} />
