---
// Nora among other people's round avatars (the chat demo; DESIGN.md §7): the
// cut-out icon on a blush-wash disc, a 2px blush ring while she is active, a
// blush dot for her presence. Beside the wordmark she is bare: NoraMark.astro.
import { Image } from "astro:assets";
import { art } from "../assets/art";

interface Props {
  size?: number;
  active?: boolean;
  dot?: boolean;
  class?: string;
}

const { size = 32, active = false, dot = false, class: className } = Astro.props;
---

<span class:list={["avatar", { active }, className]} style={`--s:${size}px`}>
  <span class="disc">
    <Image src={art.icon} alt="" width={size} densities={[1, 2, 3]} loading="eager" decoding="async" />
  </span>
  {dot && <span class="dot presence" />}
</span>

<style>
  .avatar {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    flex: none;
    border-radius: 50%;
    background: var(--blush-wash);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--blush) 22%, transparent);
  }

  .avatar.active {
    box-shadow: 0 0 0 2px var(--blush);
  }

  /* The icon's eyes sit 62% down its height; framed at 110% and lifted,
     they land just below the disc's centre, with the bun's base above. */
  .disc {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
  }

  .disc :global(img) {
    position: absolute;
    left: 50%;
    top: -12%;
    width: 110%;
    max-width: none;
    height: auto;
    transform: translateX(-50%);
  }

  .dot {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: calc(var(--s) * 0.28);
    height: calc(var(--s) * 0.28);
    min-width: 7px;
    min-height: 7px;
    box-shadow: 0 0 0 2px var(--studio);
  }
</style>
