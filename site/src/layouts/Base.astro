---
import { Font } from "astro:assets";
import "../styles/base.css";
import { LOCALES, LOCALE_ORDER, type Locale } from "../i18n";
import cjkFont from "../fonts/noto-sans-hk-subset.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { structuredData } from "../seo";

interface Props {
  locale: Locale;
  /** Overrides the locale's title (404). */
  title?: string;
  /** Home pages are the only canonical, indexable documents. */
  index?: boolean;
  /** The zh-Hant home only: send an English-first browser to /en/, as the
      portal's next-intl locale detection did, unless a language was chosen. */
  negotiate?: boolean;
}

const { locale, title, index = true, negotiate = false } = Astro.props;
const info = LOCALES[locale];
const t = info.dict;
const site = Astro.site!;
const canonical = new URL(info.path, site).href;
const ogImage = new URL(info.og, site).href;
const isZh = locale === "zh-Hant";
const ogLocale = (l: Locale) => (l === "zh-Hant" ? "zh_HK" : "en_GB");
// `<` escaped so no copy can close the script element early.
const jsonLd = JSON.stringify(structuredData(locale, site)).replace(/</g, "\\u003c");

// The CJK face is declared on the Chinese page only: the English page's one
// Chinese glyph (the language switch) is not worth 121 KB, and falls back to
// PingFang HK or the system's sans. Family order follows DESIGN.md §4.
const cjkFace = `@font-face{font-family:"Noto Sans HK";src:url(${cjkFont}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap;}`;
---

<!doctype html>
<html lang={info.lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {negotiate && <script is:inline>
      (function () {
        var chosen = null;
        try {
          chosen = localStorage.getItem("nora-lang");
        } catch (e) {}
        if (chosen || /bot|crawl|spider|preview/i.test(navigator.userAgent)) return;
        var ls = (navigator.languages || [navigator.language]).map(function (l) {
          return String(l).toLowerCase();
        });
        var zh = ls.findIndex(function (l) {
          return l.indexOf("zh") === 0 || l.indexOf("yue") === 0;
        });
        var en = ls.findIndex(function (l) {
          return l.indexOf("en") === 0;
        });
        if (en !== -1 && (zh === -1 || en < zh)) location.replace("/en/" + location.hash);
      })();
    </script>}
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {!index && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f2f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141112" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      // Before first paint: an explicit lighting choice wins over the system.
      // Storage can be missing or throw (private windows); the system
      // preference then stands and nothing breaks.
      try {
        const t = localStorage.getItem("nora-theme");
        if (t === "light" || t === "dark") {
          document.documentElement.dataset.theme = t;
          for (const m of document.querySelectorAll('meta[name="theme-color"]')) {
            m.content = t === "dark" ? "#141112" : "#f4f2f2";
          }
        }
      } catch {}
    </script>
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-wordmark" preload />
    <Font cssVariable="--font-mono" />
    {isZh && <link rel="preload" href={cjkFont} as="font" type="font/woff2" crossorigin />}
    {isZh && <style is:inline set:html={cjkFace} />}

    {index && (
      <>
        <link rel="canonical" href={canonical} />
        {LOCALE_ORDER.map((l) => (
          <link rel="alternate" hreflang={LOCALES[l].lang} href={new URL(LOCALES[l].path, site).href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />
        <script type="application/ld+json" set:html={jsonLd} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nora" />
    <meta property="og:title" content={title ?? t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {index &&
      LOCALE_ORDER.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={ogLocale(l)} />
      ))}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/_site/icon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/_site/apple-touch-icon.png" />
    <link rel="manifest" href="/_site/site.webmanifest" />
  </head>
  <body>
    <a class="skip" href="#main">
      {t.nav.skip}
    </a>
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import "../scripts/prefs.ts";
      import "../scripts/sound.ts";
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    left: 16px;
    top: 12px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: var(--radius-control);
    background: var(--ink);
    color: var(--studio);
    font-weight: 600;
    transform: translateY(-160%);
    transition: transform var(--dur) var(--ease);
  }

  .skip:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
