{
	admin off
	auto_https off
	persist_config off
}

# Loopback behind the Cloudflare Tunnel, like the portal (site/README.md).
:8080 {
	root * /srv
	encode zstd gzip

	header {
		# Baseline CSP: preserve Astro/Starlight inline scripts and resource loads.
		# Pagefind (the wiki's search) compiles WebAssembly and starts its index
		# worker: without 'wasm-unsafe-eval' in script-src and worker-src, search
		# loads but returns nothing (verified against the built wiki, 2026-10-22).
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# Hashed build output never changes under the same name.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header /_site/* Cache-Control "public, max-age=86400"
	header /favicon.ico Cache-Control "public, max-age=86400"

	# A relative Location: behind the tunnel the origin sees http, and an
	# absolute redirect would send the browser to http:// first.
	redir /en /en/ 308
	redir /wiki /wiki/ 308
	header /wiki/_astro/* Cache-Control "public, max-age=31536000, immutable"

	file_server

	handle_errors 404 {
		header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:"
		header Strict-Transport-Security "max-age=31536000"
		rewrite * /404.html
		file_server
	}
}
