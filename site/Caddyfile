{
	admin off
	auto_https off
	persist_config off
}

# Loopback behind the Cloudflare Tunnel, like the portal (site/README.md).
:8080 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# Hashed build output never changes under the same name.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header /_site/* Cache-Control "public, max-age=86400"
	header /favicon.ico Cache-Control "public, max-age=86400"

	# A relative Location: behind the tunnel the origin sees http, and an
	# absolute redirect would send the browser to http:// first.
	redir /en /en/ 308
	redir /wiki /wiki/ 308
	header /wiki/_astro/* Cache-Control "public, max-age=31536000, immutable"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
