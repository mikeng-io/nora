{
	admin off
	auto_https off
	persist_config off
}

# Loopback behind the Cloudflare Tunnel, like the portal (site/README.md).
:8080 {
	root * /srv
	encode zstd gzip

	header {
		# Baseline CSP. Inline scripts run only if their SHA-256 is listed: the image build
		# (site/scripts/csp-hashes.mjs) replaces @@CSP_SCRIPT_HASHES@@ with the hashes of every
		# inline script in the built site, so there is no 'unsafe-inline' for scripts.
		# Inline STYLES still allow 'unsafe-inline': the code-block renderer emits thousands of
		# style= attributes that a hash cannot cover.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' @@CSP_SCRIPT_HASHES@@; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# Hashed build output never changes under the same name.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header /_site/* Cache-Control "public, max-age=86400"
	header /favicon.ico Cache-Control "public, max-age=86400"

	# A relative Location: behind the tunnel the origin sees http, and an
	# absolute redirect would send the browser to http:// first.
	redir /en /en/ 308
	@wiki path /wiki /wiki/*
	redir @wiki / 308

	file_server

	handle_errors 404 {
		header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' @@CSP_SCRIPT_HASHES@@; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'"
		header Strict-Transport-Security "max-age=31536000"
		rewrite * /404.html
		file_server
	}
}
