{
  "name": "nora-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "fonts": "node scripts/fonts.mjs",
    "check": "astro check",
    "test": "node --test scripts/*.test.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"scripts/*.mjs\" astro.config.mjs"
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/noto-sans-hk": "5.3.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "es-module-lexer": "^3.0.0"
  }
}
